NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dimmo 大模型，仅在服务端读取。不要添加 NEXT_PUBLIC_ 前缀。
# 填写任一 OpenAI-compatible 供应商的 Key、Base URL 和模型名。
WORK_CAT_AI_API_KEY=your-provider-api-key
WORK_CAT_AI_BASE_URL=https://your-provider-openai-compatible-endpoint/v1
WORK_CAT_AI_MODEL=your-provider-model-name
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL；两套只配置一套即可。

# 微信支付商户平台与 API v3 配置
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://xiaoxuanvip.com/api/payments/wechat/notify

# 年费金额，单位为分，例如 9900 表示 99 元
MEMBERSHIP_ANNUAL_PRICE_CENTS=9900

# 微信服务号（JSAPI 支付，微信内一键唤起收银台；不配则自动回退扫码支付）
# 服务号 AppID，通常与 WECHAT_PAY_APP_ID 相同，相同则留空
WECHAT_OFFICIAL_APP_ID=
# 服务号 AppSecret（公众号后台 → 设置与开发 → 基本配置 → 开发者密码）
WECHAT_OFFICIAL_APP_SECRET=
