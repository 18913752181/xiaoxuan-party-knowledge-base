NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://xiaoxuanvip.com
WECHAT_TOKEN=your-wechat-callback-token
WECHAT_ENCODING_AES_KEY=your-43-character-encoding-aes-key
WECHAT_OFFICIAL_APP_ID=wx_your-official-account-appid
WECHAT_OFFICIAL_APP_SECRET=your-official-account-app-secret
# Dimmo 大模型，仅保存在服务端。Base URL 指向供应商的 OpenAI-compatible /v1 地址。
# 切换 OpenAI、DeepSeek、通义千问或豆包时，只替换下面三项，不改代码。
WORK_CAT_AI_API_KEY=your-provider-api-key
WORK_CAT_AI_BASE_URL=https://your-provider-openai-compatible-endpoint/v1
WORK_CAT_AI_MODEL=your-provider-model-name
# 会员到点提醒内部调度密钥：请替换成随机长字符串，不要和公众号 Token 共用。
REMINDER_CRON_SECRET=replace-with-a-long-random-secret
# 也兼容标准别名 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL；两套只配置一套即可。
APP_ENV_FILE=/srv/xiaoxuan/shared/app.env
CONTENT_DIR=/srv/xiaoxuan/shared/content
DATA_DIR=/srv/xiaoxuan/shared/data
APP_UID=1000
APP_GID=1000

# Dimmo 与资料库统一会员套餐价格，单位为分。
DIMMO_MONTHLY_PRICE_CENTS=2800
DIMMO_QUARTERLY_PRICE_CENTS=7900
DIMMO_ANNUAL_PRICE_CENTS=29900
