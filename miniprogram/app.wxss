page {
  min-height: 100%;
  background: #f5f6f2;
  color: #26312c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input, picker { box-sizing: border-box; }
button::after { border: 0; }

.page-shell { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #678274; font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-title { margin-top: 12rpx; color: #233029; font-size: 46rpx; font-weight: 700; line-height: 1.28; }
.page-subtitle { margin-top: 16rpx; color: #68716c; font-size: 27rpx; line-height: 1.75; }
.surface { border: 1rpx solid #e2e5df; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(35, 48, 41, .045); }
.primary-button { display: flex; align-items: center; justify-content: center; height: 92rpx; border-radius: 22rpx; background: #547565; color: #fff; font-size: 29rpx; font-weight: 600; line-height: 92rpx; }
.primary-button:active { background: #466556; }
.secondary-button { display: flex; align-items: center; justify-content: center; height: 84rpx; border: 1rpx solid #dce2dd; border-radius: 20rpx; background: #fff; color: #4f695c; font-size: 28rpx; }
.section-card { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #e2e5df; border-radius: 26rpx; background: #fff; }
.section-heading { display: flex; align-items: center; gap: 14rpx; }
.section-index { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 14rpx; background: #eaf0ec; color: #547565; font-size: 22rpx; font-weight: 700; }
.section-title { color: #26312c; font-size: 31rpx; font-weight: 700; }
.muted { color: #758079; }
