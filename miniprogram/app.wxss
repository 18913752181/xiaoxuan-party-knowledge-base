page {
  min-height: 100%;
  background-color: #f8f9f7;
  color: #20231f;
  font-family: "PingFang SC", "OPPO Sans", -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

view, text, button, input, picker { box-sizing: border-box; }
button::after { border: 0; }

.page-shell { padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #735711; font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; }
.page-title { margin-top: 14rpx; color: #20231f; font-size: 48rpx; font-weight: 750; line-height: 1.3; letter-spacing: -1rpx; }
.page-subtitle { margin-top: 16rpx; color: #6f756e; font-size: 26rpx; line-height: 1.75; }
.surface { border: 1rpx solid #e4e8e2; border-radius: 18rpx; background: #ffffff; box-shadow: none; }
.primary-button { display: flex; align-items: center; justify-content: center; height: 92rpx; border: 1rpx solid #e1c56d; border-radius: 14rpx; background: #fff4cf; color: #735711; box-shadow: none; font-size: 28rpx; font-weight: 650; line-height: 92rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.primary-button:active { background: #f6e6ad; transform: scale(.985); }
.primary-button[disabled] { border-color: #e4e8e2; background: #eeeae2; color: #a7ada6; box-shadow: none; }
.secondary-button { display: flex; align-items: center; justify-content: center; height: 88rpx; border: 1rpx solid #e4e8e2; border-radius: 14rpx; background: #fff4cf; color: #735711; box-shadow: none; font-size: 27rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.secondary-button:active { background: #f6e6ad; transform: scale(.985); }
.section-card { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #e4e8e2; border-radius: 18rpx; background: #ffffff; box-shadow: none; }
.section-heading { display: flex; align-items: center; gap: 14rpx; }
.section-index { display: flex; align-items: center; justify-content: center; min-width: 48rpx; height: 48rpx; padding: 0 12rpx; border-radius: 10rpx; background: #fff4cf; color: #735711; font-size: 22rpx; font-weight: 700; }
.section-title { color: #20231f; font-size: 31rpx; font-weight: 700; }
.muted { color: #6f756e; }
@media (prefers-reduced-motion: reduce) {
  .primary-button, .secondary-button { transition-property: background-color; }
  .primary-button:active, .secondary-button:active { transform: none; }
}

