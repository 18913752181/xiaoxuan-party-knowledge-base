page {
  min-height: 100%;
  background: #faf6f0;
  color: #403731;
  font-family: "PingFang SC", "OPPO Sans", -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

view, text, button, input, picker { box-sizing: border-box; }
button::after { border: 0; }

.page-shell { padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #c77c43; font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-title { margin-top: 14rpx; color: #403731; font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1rpx; }
.page-subtitle { margin-top: 18rpx; color: #8b8178; font-size: 27rpx; line-height: 1.78; }
.surface { border: 0; border-radius: 32rpx; background: #fffdfa; box-shadow: 0 18rpx 52rpx rgba(142, 101, 66, .09); }
.primary-button { display: flex; align-items: center; justify-content: center; height: 96rpx; border: 0; border-radius: 999rpx; background: linear-gradient(135deg, #ad6135 0%, #a65a31 100%); color: #fffaf5; box-shadow: 0 14rpx 30rpx rgba(166, 90, 49, .2); font-size: 29rpx; font-weight: 600; line-height: 96rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.primary-button:active { background: #8f4826; transform: scale(.97); }
.primary-button[disabled] { background: #eaded4; color: #aa9c91; box-shadow: none; }
.secondary-button { display: flex; align-items: center; justify-content: center; height: 88rpx; border: 0; border-radius: 999rpx; background: #fffdfa; color: #a65a31; box-shadow: 0 12rpx 32rpx rgba(142, 101, 66, .07); font-size: 28rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.secondary-button:active { background: #fff5ec; transform: scale(.97); }
.section-card { margin-top: 26rpx; padding: 32rpx; border: 0; border-radius: 30rpx; background: #fffdfa; box-shadow: 0 14rpx 42rpx rgba(142, 101, 66, .075); }
.section-heading { display: flex; align-items: center; gap: 14rpx; }
.section-index { display: flex; align-items: center; justify-content: center; min-width: 48rpx; height: 48rpx; padding: 0 12rpx; border-radius: 999rpx; background: #fff0e4; color: #c77c43; font-size: 22rpx; font-weight: 700; }
.section-title { color: #403731; font-size: 31rpx; font-weight: 700; }
.muted { color: #8b8178; }
@media (prefers-reduced-motion: reduce) {
  .primary-button, .secondary-button { transition-property: background-color; }
  .primary-button:active, .secondary-button:active { transform: none; }
}
