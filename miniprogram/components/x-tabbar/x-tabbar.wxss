.tabbar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; height: 108rpx; padding: 10rpx 26rpx; border-top: 1rpx solid #e4e8e2; background: rgba(255,255,255,.97); box-shadow: none; backdrop-filter: blur(18rpx); }
.safe-bottom { padding-bottom: calc(10rpx + env(safe-area-inset-bottom)); height: calc(108rpx + env(safe-area-inset-bottom)); }
.tab-item { display: flex; flex: 1; align-items: center; justify-content: center; gap: 8rpx; color: #908b82; font-size: 22rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), color 140ms ease; }
.tab-item:active { transform: scale(.97); }
.tab-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; color: #827d74; font-size: 34rpx; line-height: 1; }
.tab-item.is-active { color: #20231f; font-weight: 650; }
.tab-item.is-active .tab-icon { border-radius: 8rpx; background: #e7b93f; color: #20231f; }
@media (prefers-reduced-motion: reduce) {
  .tab-item { transition-property: color; }
  .tab-item:active { transform: none; }
}

