.plan-page { padding-bottom: 70rpx; }
.plan-hero { padding: 34rpx; background: linear-gradient(145deg, #fff9f1, #f6e8da); }
.plan-hero .page-title { margin-top: 10rpx; font-size: 45rpx; }
.plan-hero .page-subtitle { margin-top: 12rpx; font-size: 24rpx; }
.plan-summary { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; color: #97877b; font-size: 22rpx; }
.summary-number { color: #b96d39; font-size: 39rpx; font-weight: 700; }
.stop-row { display: flex; align-items: center; gap: 18rpx; padding: 25rpx 0; border-bottom: 1rpx solid #f1e7de; }
.stop-order { display: flex; flex: none; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #fff0e4; color: #bd7543; font-size: 23rpx; font-weight: 700; }
.stop-content { min-width: 0; flex: 1; color: #594b42; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.stop-content text { display: block; overflow: hidden; margin-top: 5rpx; color: #9a8e85; font-size: 21rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.remove-stop { padding: 12rpx 4rpx; color: #bb7a4b; font-size: 22rpx; }
.add-stop { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 23rpx; border-radius: 22rpx; background: #fff9f3; color: #85766b; font-size: 24rpx; }
.select-stop { color: #b96d39; }
.warm-note { background: #fff9f3; }
.tip-line { margin-top: 17rpx; color: #7d6c61; font-size: 24rpx; line-height: 1.7; }
.plan-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.plan-actions button { flex: 1; font-size: 25rpx; }
.clear-button { color: #b69c8a; }
