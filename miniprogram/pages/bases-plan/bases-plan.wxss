.plan-page { padding-bottom: 70rpx; }
.plan-hero { padding: 34rpx; background: linear-gradient(145deg, #ffffff, #f6e8da); }
.plan-hero .page-title { margin-top: 10rpx; font-size: 45rpx; }
.plan-hero .page-subtitle { margin-top: 12rpx; font-size: 24rpx; }
.plan-summary { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; color: #969c95; font-size: 22rpx; }
.summary-number { color: #8a6815; font-size: 39rpx; font-weight: 700; }
.stop-row { display: flex; align-items: center; gap: 18rpx; padding: 25rpx 0; border-bottom: 1rpx solid #e4e8e2; }
.stop-order { display: flex; flex: none; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #fff4cf; color: #8a6815; font-size: 23rpx; font-weight: 700; }
.stop-content { min-width: 0; flex: 1; color: #424741; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.stop-content text { display: block; overflow: hidden; margin-top: 5rpx; color: #969c95; font-size: 21rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.remove-stop { padding: 12rpx 4rpx; color: #8a6815; font-size: 22rpx; }
.add-stop { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 23rpx; border-radius: 22rpx; background: #ffffff; color: #85766b; font-size: 24rpx; }
.select-stop { color: #8a6815; }
.warm-note { background: #ffffff; }
.tip-line { margin-top: 17rpx; color: #6f756e; font-size: 24rpx; line-height: 1.7; }
.plan-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.plan-actions button { flex: 1; font-size: 25rpx; }
.clear-button { color: #b69c8a; }

/* Oil visual system */
.plan-hero { border-color: #e4e8e2; border-top: 4rpx solid #e7b93f; background: #ffffff; }
.plan-hero .page-title, .stop-content { color: #20231f; }
.plan-hero .page-subtitle, .plan-summary, .stop-content text { color: #6f756e; }
.summary-number { color: #735711; }
.stop-order { border-radius: 9rpx; background: #e7b93f; color: #4f3d0d; }
.remove-stop, .select-stop { color: #735711; }
.add-stop, .warm-note { border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #fff; }
.clear-button { color: #888279; }

