<view class="page-shell flow-page">
  <view class="eyebrow">🧭 发展党员全流程</view>
  <view class="page-title">现在做到哪个步骤？<text>我帮你往后捋。</text></view>
  <view class="page-subtitle">选一个你已经完成的步骤，填入实际日期，就能看到后续要关注的时间节点和下一步工作。</view>
  <view class="coverage-note">覆盖全流程节点</view>

  <view class="input-card surface">
    <view class="input-card-title">先告诉我你做到哪一步</view>
    <view class="input-label">已经完成的步骤</view>
    <picker mode="selector" range="{{nodeOptions}}" value="{{selectedNodeIndex}}" bindchange="selectNode">
      <view class="selector-value"><text class="selector-order">{{selectedNodeIndex + 1}}</text><text class="selector-text">{{selectedNodeTitle}}</text><text class="selector-arrow">⌄</text></view>
    </picker>
    <view class="input-label date-label">这一步的实际完成日期</view>
    <picker mode="date" value="{{selectedDate}}" end="{{maxDate}}" bindchange="selectDate">
      <view class="date-value {{selectedDate ? 'selected' : ''}}">{{selectedDate || '请选择日期'}}</view>
    </picker>
    <button class="calculate-button" bindtap="calculate">开始推算</button>
    <view class="input-tip"><text>🐾 只填你确定的日期就好。</text><text>有些节点不能只靠日期判断，我会标成「待确认」，不替你乱猜。</text></view>
  </view>

  <view wx:if="{{hasCalculated}}" id="calculationSummary" class="result-overview">
    <view class="result-kicker">接下来这样办</view>
    <view class="known-row">
      <view><view class="overview-label">当前已知节点</view><view class="known-title">{{calculationSummary.selectedTitle}}</view></view>
      <view class="known-date">{{calculationSummary.selectedDate}}</view>
    </view>

    <view wx:if="{{calculationSummary.nextStep}}" class="next-card">
      <view class="next-card-label">下一步</view>
      <view class="next-card-title">{{calculationSummary.nextStep.title}}</view>
      <view class="next-focus">
        <view class="next-focus-item"><text class="overview-label">建议关注时间</text><text class="next-focus-value">{{calculationSummary.nextStep.dateText}}</text></view>
        <view class="next-focus-item"><text class="overview-label">对应材料</text><text class="next-focus-value">{{calculationSummary.nextStep.materialText}}</text></view>
      </view>
      <view class="next-summary">{{calculationSummary.nextStep.summary}}</view>
    </view>
    <view wx:else class="next-card next-card-finished">
      <view class="next-card-label">下一步</view>
      <view class="next-card-title">已到达当前流程的最后一个节点</view>
      <view class="next-summary">请结合实际归档情况和上级党组织要求完成核对。</view>
    </view>

    <view class="summary-card">
      <view class="summary-title">后续节点概览</view>
      <view class="summary-stats">
        <view class="summary-stat"><text class="stat-value">{{calculationSummary.total}}</text><text class="stat-label">后续及当前节点</text></view>
        <view class="summary-stat"><text class="stat-value">{{calculationSummary.calculable}}</text><text class="stat-label">有时间或条件参考</text></view>
        <view class="summary-stat"><text class="stat-value">{{calculationSummary.pending}}</text><text class="stat-label">待确认事项</text></view>
      </view>
    </view>
  </view>

  <view class="section-head">
    <view><view class="section-index">阶段</view><view class="section-title">发展阶段</view></view>
    <view class="full-toggle" bindtap="toggleFull">{{showFull ? '收起完整流程' : '查看完整流程'}}</view>
  </view>

  <scroll-view class="stage-scroll" scroll-x enhanced scroll-into-view="{{activeStageAnchor}}" scroll-with-animation show-scrollbar="{{false}}">
    <view class="stage-track">
      <view wx:for="{{stages}}" wx:key="id" id="stage-{{item.id}}" class="stage-item {{activeStageId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectStage">
        <view class="stage-number">{{item.order}}</view>
        <view class="stage-name">{{item.shortName}}</view>
        <view class="stage-count">{{item.count}}步</view>
      </view>
    </view>
  </scroll-view>

  <view class="section-head timeline-head">
    <view><view class="section-index">步骤</view><view class="section-title">{{showFull ? '完整流程时间轴' : '当前阶段详细步骤'}}</view></view>
  </view>

  <view wx:for="{{visibleGroups}}" wx:key="id" class="stage-group">
    <view wx:if="{{showFull}}" class="group-title"><text>{{item.name}}</text><text>{{item.nodes.length}} 个节点</text></view>
    <view class="timeline">
      <view wx:for="{{item.nodes}}" wx:for-item="node" wx:key="id" class="timeline-row" data-id="{{node.id}}" bindtap="openDetail">
        <view class="timeline-rail"><view class="timeline-dot {{node.schedule ? 'status-' + node.schedule.status : ''}}">{{node.orderText}}</view><view wx:if="{{index < item.nodes.length - 1}}" class="timeline-line"></view></view>
        <view class="node-card">
          <view class="node-top"><view class="node-title">{{node.title}}</view><view class="detail-arrow">›</view></view>
          <view class="node-meta"><text class="time-chip">{{node.timeRequirement}}</text><text>{{node.partyText}}</text></view>
          <view wx:if="{{node.schedule}}" class="schedule schedule-{{node.schedule.status}}">
            <view class="schedule-top"><text class="schedule-label">{{node.schedule.statusLabel}}</text><text class="schedule-date">{{node.schedule.dateText}}</text></view>
            <view class="schedule-summary">{{node.schedule.summary}}</view>
          </view>
          <view class="material-hint">{{node.materialCount ? '关联 ' + node.materialCount + ' 项材料' : '材料信息待确认'}} · 点击查看详情</view>
        </view>
      </view>
    </view>
  </view>

  <view class="notice-card">
    <view class="notice-title">时间推算说明</view>
    <view class="notice-line">“最早参考”只表示达到流程资料或已确认规则中的时间条件，不代表前置程序已经完成。</view>
    <view class="notice-line">“条件参考”表示只能判断先后关系，党委会、公示无异议、组织研究等实际日期仍需人工确定。</view>
    <view class="notice-line">五个工作日仅按周一至周五演算，法定节假日和调休必须另行核对。</view>
    <view class="disclaimer">{{disclaimer}}</view>
  </view>

  <view class="website-card" bindtap="openWebsite"><view class="website-icon">资料</view>
    <view><view class="website-kicker">网站统一维护</view><view class="website-title">查看发展党员专题资料</view><view class="website-copy">打开指定资料页，查看模板、流程说明和相关内容</view></view>
    <view class="website-arrow">→</view>
  </view>
  <view class="source-note">数据版本 {{sourceVersion}} · 来源 {{sourceTitle}}</view>
</view>

<view wx:if="{{detailVisible}}" class="drawer-mask {{detailOpen ? 'is-open' : ''}}" catchtap="closeDetail">
  <view class="detail-drawer" catchtap="preventClose">
    <view class="drawer-handle"></view>
    <view class="drawer-head"><view><view class="drawer-kicker">步骤 {{detail.orderText}}</view><view class="drawer-title">{{detail.title}}</view></view><view class="drawer-close" bindtap="closeDetail">×</view></view>
    <scroll-view class="drawer-scroll" scroll-y>
      <view wx:if="{{detail.schedule}}" class="detail-schedule schedule-{{detail.schedule.status}}">
        <view class="schedule-top"><text class="schedule-label">{{detail.schedule.statusLabel}}</text><text class="schedule-date">{{detail.schedule.dateText}}</text></view>
        <view class="schedule-summary">{{detail.schedule.summary}}</view>
      </view>
      <view class="detail-block"><view class="detail-label">这一步做什么</view><view class="detail-value">{{detail.action}}</view></view>
      <view class="detail-grid">
        <view class="detail-block"><view class="detail-label">谁负责</view><view class="detail-value">{{detail.partyText}}</view></view>
        <view class="detail-block"><view class="detail-label">什么时候做</view><view class="detail-value">{{detail.timeRequirement}}</view></view>
      </view>
      <view class="detail-block"><view class="detail-label">前置条件</view><view class="detail-value">{{detail.prerequisite}}</view></view>
      <view class="detail-block"><view class="detail-label">所需 / 形成材料</view><view class="material-warning">{{detail.materialClassification}}</view><view wx:for="{{detail.materialText}}" wx:key="*this" class="material-item">{{item}}</view></view>
      <view class="detail-block"><view class="detail-label">注意事项</view><view wx:for="{{detail.noteList}}" wx:key="*this" class="note-item">{{item}}</view></view>
      <view class="detail-nav"><view><text class="detail-label">上一步</text><text class="nav-text">{{detail.previousText}}</text></view><view><text class="detail-label">下一步</text><text class="nav-text">{{detail.nextText}}</text></view></view>
    </scroll-view>
  </view>
</view>
