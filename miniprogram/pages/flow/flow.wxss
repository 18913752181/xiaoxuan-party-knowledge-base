.flow-page { padding-bottom: 48rpx; }
.page-title { margin-top: 14rpx; font-size: 52rpx; line-height: 1.25; font-weight: 700; color: #30312f; letter-spacing: -1rpx; }
.page-subtitle { margin-top: 20rpx; color: #777873; font-size: 28rpx; line-height: 1.8; }
.input-card { margin-top: 34rpx; padding: 32rpx; border-radius: 28rpx; }
.input-label { color: #646661; font-size: 24rpx; font-weight: 600; }
.date-label { margin-top: 28rpx; }
.selector-value, .date-value { margin-top: 14rpx; min-height: 96rpx; box-sizing: border-box; display: flex; align-items: center; border: 2rpx solid #e4e2dd; border-radius: 20rpx; background: #f7f7f4; padding: 0 24rpx; color: #30312f; font-size: 28rpx; }
.selector-order { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #e9efeb; color: #5c776b; font-size: 22rpx; font-weight: 700; flex: none; }
.selector-text { margin-left: 18rpx; line-height: 1.45; flex: 1; }
.selector-arrow { margin-left: 12rpx; color: #999b96; font-size: 32rpx; }
.date-value { color: #aaa9a5; }
.date-value.selected { color: #30312f; }
.calculate-button { margin-top: 28rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 22rpx; background: #8f4b51; color: #fff; font-size: 29rpx; font-weight: 600; }
.calculate-button::after { border: 0; }
.input-tip { margin-top: 20rpx; color: #898a86; font-size: 23rpx; line-height: 1.7; }
.summary-card { margin-top: 26rpx; padding: 30rpx; border-radius: 28rpx; background: #34443d; color: #fff; }
.summary-kicker { color: rgba(255,255,255,.58); font-size: 22rpx; }
.summary-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 650; line-height: 1.45; }
.summary-date { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 24rpx; }
.summary-stats { margin-top: 26rpx; padding-top: 24rpx; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1rpx solid rgba(255,255,255,.14); }
.summary-stat { display: flex; flex-direction: column; }
.stat-value { font-size: 34rpx; font-weight: 700; }
.stat-label { margin-top: 6rpx; color: rgba(255,255,255,.6); font-size: 20rpx; line-height: 1.35; }
.section-head { margin-top: 48rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.section-index { color: #9a565b; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-title { margin-top: 8rpx; color: #30312f; font-size: 36rpx; font-weight: 700; }
.full-toggle { padding: 14rpx 18rpx; border-radius: 16rpx; background: #e9efeb; color: #536f62; font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.stage-scroll { margin: 24rpx -28rpx 0; width: calc(100% + 56rpx); }
.stage-track { display: flex; width: max-content; padding: 0 28rpx 10rpx; gap: 14rpx; }
.stage-item { width: 164rpx; min-height: 160rpx; box-sizing: border-box; padding: 20rpx; border: 2rpx solid #e4e2dd; border-radius: 22rpx; background: #fffefa; color: #777873; }
.stage-item.active { border-color: #718b7f; background: #edf2ee; color: #385448; }
.stage-number { font-size: 20rpx; font-weight: 700; }
.stage-name { margin-top: 12rpx; min-height: 52rpx; font-size: 25rpx; font-weight: 650; line-height: 1.35; }
.stage-count { margin-top: 10rpx; font-size: 20rpx; opacity: .7; }
.timeline-head { margin-top: 40rpx; }
.stage-group { margin-top: 24rpx; }
.group-title { margin: 34rpx 0 20rpx; display: flex; justify-content: space-between; color: #536f62; font-size: 25rpx; font-weight: 650; }
.group-title text:last-child { color: #979894; font-size: 21rpx; font-weight: 400; }
.timeline-row { display: flex; align-items: stretch; }
.timeline-rail { width: 78rpx; display: flex; align-items: center; flex-direction: column; flex: none; }
.timeline-dot { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #dddcd7; border-radius: 18rpx; background: #fffefa; color: #858681; font-size: 19rpx; font-weight: 700; z-index: 1; }
.timeline-dot.status-known { border-color: #8f4b51; background: #8f4b51; color: #fff; }
.timeline-dot.status-earliest, .timeline-dot.status-reference { border-color: #718b7f; background: #e9f0ec; color: #4c6b5d; }
.timeline-dot.status-deadline, .timeline-dot.status-advisory { border-color: #c89556; background: #faf1e2; color: #89683f; }
.timeline-dot.status-condition { border-color: #8a9690; background: #eef0ee; color: #5f6c66; }
.timeline-line { width: 2rpx; flex: 1; min-height: 34rpx; background: #dddcd7; }
.node-card { margin: 0 0 20rpx 6rpx; padding: 26rpx; flex: 1; min-width: 0; border: 2rpx solid #e4e2dd; border-radius: 24rpx; background: #fffefa; box-shadow: 0 8rpx 24rpx rgba(56,53,48,.035); }
.node-top { display: flex; gap: 16rpx; align-items: flex-start; }
.node-title { flex: 1; color: #30312f; font-size: 28rpx; font-weight: 650; line-height: 1.55; }
.detail-arrow { color: #aaa9a5; font-size: 36rpx; line-height: 1; }
.node-meta { margin-top: 16rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; color: #878883; font-size: 21rpx; }
.time-chip { padding: 8rpx 12rpx; border-radius: 12rpx; background: #f1f0ed; color: #656762; }
.schedule { margin-top: 20rpx; padding: 20rpx; border-radius: 18rpx; background: #edf2ee; }
.schedule-deadline, .schedule-advisory { background: #faf2e5; }
.schedule-condition { background: #f0f1ef; }
.schedule-pending { background: #f4f3f0; }
.schedule-before { background: #f6f5f2; opacity: .75; }
.schedule-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.schedule-label { color: #557164; font-size: 20rpx; font-weight: 700; }
.schedule-deadline .schedule-label, .schedule-advisory .schedule-label { color: #8b683d; }
.schedule-date { color: #30312f; font-size: 24rpx; font-weight: 700; text-align: right; }
.schedule-summary { margin-top: 10rpx; color: #747570; font-size: 21rpx; line-height: 1.6; }
.material-hint { margin-top: 18rpx; color: #a0a19d; font-size: 20rpx; }
.notice-card { margin-top: 40rpx; padding: 30rpx; border-radius: 26rpx; background: #efeee9; }
.notice-title { color: #30312f; font-size: 27rpx; font-weight: 650; }
.notice-line { position: relative; margin-top: 16rpx; padding-left: 22rpx; color: #73746f; font-size: 23rpx; line-height: 1.7; }
.notice-line::before { content: ""; position: absolute; left: 0; top: 15rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #718b7f; }
.disclaimer { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #dbdad5; color: #6e5a4b; font-size: 22rpx; line-height: 1.7; }
.website-card { margin-top: 24rpx; padding: 30rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-radius: 26rpx; background: #fffefa; border: 2rpx solid #e4e2dd; }
.website-kicker { color: #9a565b; font-size: 20rpx; font-weight: 650; }
.website-title { margin-top: 8rpx; color: #30312f; font-size: 28rpx; font-weight: 650; }
.website-copy { margin-top: 8rpx; color: #8a8b86; font-size: 21rpx; line-height: 1.5; }
.website-arrow { color: #718b7f; font-size: 38rpx; }
.source-note { margin-top: 22rpx; color: #aaa9a5; font-size: 20rpx; text-align: center; }
.drawer-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(35,37,35,.44); }
.detail-drawer { width: 100%; max-height: 88vh; box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: #fafaf8; overflow: hidden; }
.drawer-handle { width: 74rpx; height: 8rpx; margin: 16rpx auto 8rpx; border-radius: 8rpx; background: #d6d5d1; }
.drawer-head { padding: 18rpx 30rpx 24rpx; display: flex; align-items: flex-start; gap: 20rpx; border-bottom: 1rpx solid #e4e2dd; background: #fffefa; }
.drawer-head > view:first-child { flex: 1; min-width: 0; }
.drawer-kicker { color: #9a565b; font-size: 20rpx; font-weight: 700; }
.drawer-title { margin-top: 8rpx; color: #30312f; font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.drawer-close { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #efeee9; color: #72736f; font-size: 38rpx; }
.drawer-scroll { height: 68vh; box-sizing: border-box; padding: 28rpx 30rpx 60rpx; }
.detail-schedule { padding: 22rpx; border-radius: 20rpx; background: #edf2ee; }
.detail-block { margin-top: 26rpx; padding: 24rpx; border-radius: 22rpx; background: #fffefa; border: 1rpx solid #e4e2dd; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.detail-grid .detail-block { min-width: 0; }
.detail-label { display: block; color: #92938e; font-size: 20rpx; font-weight: 600; }
.detail-value { margin-top: 10rpx; color: #3c3e3a; font-size: 25rpx; line-height: 1.65; }
.material-warning { margin-top: 10rpx; color: #8b6942; font-size: 21rpx; line-height: 1.55; }
.material-item, .note-item { position: relative; margin-top: 14rpx; padding-left: 22rpx; color: #555752; font-size: 24rpx; line-height: 1.6; }
.material-item::before, .note-item::before { content: ""; position: absolute; left: 0; top: 15rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #718b7f; }
.detail-nav { margin: 26rpx 0 50rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.detail-nav > view { padding: 22rpx; border-radius: 20rpx; background: #efeee9; min-width: 0; }
.nav-text { display: block; margin-top: 10rpx; color: #4d4f4b; font-size: 22rpx; line-height: 1.5; }
