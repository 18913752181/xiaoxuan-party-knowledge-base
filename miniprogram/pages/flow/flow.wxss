.flow-page { padding-top: 30rpx; padding-bottom: 52rpx; }
.page-title { margin-top: 14rpx; font-size: 52rpx; line-height: 1.26; font-weight: 700; color: #403731; letter-spacing: -1rpx; }
.page-title text { display: block; }
.page-subtitle { margin-top: 20rpx; color: #8b8178; font-size: 28rpx; line-height: 1.8; }
.coverage-note { margin-top: 14rpx; color: #a7ada6; font-size: 22rpx; }
.input-card { margin-top: 30rpx; padding: 34rpx; border-radius: 34rpx; background: linear-gradient(145deg, #ffffff 0%, #fdf0e2 100%); }
.input-card-title { margin-bottom: 26rpx; color: #20231f; font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.input-label { color: #7e614e; font-size: 24rpx; font-weight: 600; }
.date-label { margin-top: 28rpx; }
.selector-value, .date-value { margin-top: 14rpx; min-height: 96rpx; box-sizing: border-box; display: flex; align-items: center; border: 0; border-radius: 26rpx; background: rgba(255,255,255,.75); padding: 0 24rpx; color: #424741; box-shadow: 0 9rpx 24rpx rgba(142,101,66,.055); font-size: 28rpx; }
.selector-order { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: #fff4cf; color: #8a6815; font-size: 22rpx; font-weight: 700; flex: none; }
.selector-text { margin-left: 18rpx; line-height: 1.45; flex: 1; }
.selector-arrow { margin-left: 12rpx; color: #b2a59b; font-size: 32rpx; }
.date-value { color: #afa299; }
.date-value.selected { background: #fff4cf; color: #735711; }
.calculate-button { margin-top: 28rpx; height: 98rpx; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 999rpx; background: linear-gradient(135deg, #edb083 0%, #e39a68 100%); color: #ffffff; box-shadow: 0 14rpx 30rpx rgba(205,130,75,.19); font-size: 29rpx; font-weight: 600; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.calculate-button:active { transform: scale(.97); }
.calculate-button::after { border: 0; }
.input-tip { margin-top: 22rpx; color: #6f756e; font-size: 23rpx; line-height: 1.7; }
.input-tip text { display: block; }
.result-overview { margin-top: 40rpx; scroll-margin-top: 24rpx; }
.result-kicker { color: #735711; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.known-row { margin-top: 16rpx; padding: 26rpx 4rpx 24rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #e4e8e2; }
.overview-label { display: block; color: #858b84; font-size: 21rpx; font-weight: 600; }
.known-title { margin-top: 9rpx; color: #20231f; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.known-date { padding-top: 34rpx; color: #6f756e; font-size: 22rpx; white-space: nowrap; }
.next-card { margin-top: 24rpx; padding: 32rpx; border: 1rpx solid #d6b14a; border-radius: 18rpx; background: #fff4cf; box-shadow: 0 14rpx 32rpx rgba(115,87,17,.08); }
.next-card-label { color: #735711; font-size: 22rpx; font-weight: 700; }
.next-card-title { margin-top: 12rpx; color: #20231f; font-size: 34rpx; font-weight: 750; line-height: 1.42; }
.next-focus { margin-top: 26rpx; display: grid; grid-template-columns: 1.45fr .75fr; gap: 14rpx; }
.next-focus-item { min-width: 0; padding: 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.72); }
.next-focus-value { display: block; margin-top: 8rpx; color: #20231f; font-size: 25rpx; font-weight: 700; line-height: 1.45; }
.next-summary { margin-top: 20rpx; color: #655928; font-size: 22rpx; line-height: 1.65; }
.next-card-finished { border-color: #e4e8e2; background: #ffffff; }
.next-card-finished .next-summary { color: #6f756e; }
.summary-card { margin-top: 28rpx; padding: 32rpx; border-radius: 34rpx; background: linear-gradient(145deg, #efb48b 0%, #e29a68 100%); color: #ffffff; box-shadow: 0 18rpx 42rpx rgba(205,130,75,.17); }
.summary-kicker { color: rgba(255,250,245,.7); font-size: 22rpx; }
.summary-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 650; line-height: 1.45; }
.summary-date { margin-top: 8rpx; color: rgba(255,250,245,.82); font-size: 24rpx; }
.summary-stats { margin-top: 26rpx; padding: 22rpx; display: grid; grid-template-columns: repeat(3, 1fr); border-radius: 26rpx; background: rgba(255,255,255,.16); }
.summary-stat { display: flex; flex-direction: column; }
.stat-value { font-size: 34rpx; font-weight: 700; }
.stat-label { margin-top: 6rpx; color: rgba(255,250,245,.7); font-size: 20rpx; line-height: 1.35; }
.section-head { margin-top: 50rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.section-index { display: flex; align-items: center; justify-content: center; width: auto; min-width: 52rpx; height: 44rpx; padding: 0 12rpx; border-radius: 19rpx; background: #fff4cf; font-size: 19rpx; font-weight: 700; }
.section-title { margin-top: 10rpx; color: #403731; font-size: 36rpx; font-weight: 700; }
.full-toggle { padding: 15rpx 20rpx; border-radius: 999rpx; background: #fff4cf; color: #8a6815; font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.stage-scroll { margin: 24rpx -32rpx 0; width: calc(100% + 64rpx); }
.stage-track { display: flex; width: max-content; padding: 0 32rpx 14rpx; gap: 16rpx; }
.stage-item { width: 166rpx; min-height: 164rpx; box-sizing: border-box; padding: 22rpx; border: 0; border-radius: 28rpx; background: #ffffff; color: #91857c; box-shadow: 0 12rpx 32rpx rgba(142,101,66,.07); transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 180ms ease; }
.stage-item:active { transform: scale(.97); }
.stage-item.active { background: linear-gradient(145deg, #fff4cf 0%, #f7ddc8 100%); color: #a96232; box-shadow: 0 14rpx 34rpx rgba(205,130,75,.12); }
.stage-number { font-size: 20rpx; font-weight: 700; }
.stage-name { margin-top: 12rpx; min-height: 52rpx; font-size: 25rpx; font-weight: 650; line-height: 1.35; }
.stage-count { margin-top: 10rpx; font-size: 20rpx; opacity: .72; }
.timeline-head { margin-top: 40rpx; }
.stage-group { margin-top: 24rpx; }
.group-title { margin: 34rpx 0 20rpx; display: flex; justify-content: space-between; color: #8a6815; font-size: 25rpx; font-weight: 650; }
.group-title text:last-child { color: #a7ada6; font-size: 21rpx; font-weight: 400; }
.timeline-row { display: flex; align-items: stretch; }
.timeline-rail { width: 78rpx; display: flex; align-items: center; flex-direction: column; flex: none; }
.timeline-dot { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 0; border-radius: 20rpx; background: #f2f4f1; color: #a88f7d; box-shadow: 0 6rpx 16rpx rgba(32,35,31,.035); font-size: 19rpx; font-weight: 700; z-index: 1; }
.timeline-dot.status-known { background: #e8a87c; color: #ffffff; }
.timeline-dot.status-earliest, .timeline-dot.status-reference { background: #f7d9c2; color: #a96335; }
.timeline-dot.status-deadline, .timeline-dot.status-advisory { background: #f2c7a7; color: #915529; }
.timeline-dot.status-condition { background: #f2f4f1; color: #98755e; }
.timeline-line { width: 3rpx; flex: 1; min-height: 34rpx; border-radius: 999rpx; background: #e4e8e2; }
.node-card { margin: 0 0 22rpx 6rpx; padding: 28rpx; flex: 1; min-width: 0; border: 0; border-radius: 30rpx; background: #ffffff; box-shadow: 0 13rpx 38rpx rgba(32,35,31,.04); transition: transform 140ms cubic-bezier(.23,1,.32,1); }
.timeline-row:active .node-card { transform: scale(.985); }
.node-top { display: flex; gap: 16rpx; align-items: flex-start; }
.node-title { flex: 1; color: #424741; font-size: 28rpx; font-weight: 650; line-height: 1.55; }
.detail-arrow { color: #d49b72; font-size: 36rpx; line-height: 1; }
.node-meta { margin-top: 16rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; color: #969c95; font-size: 21rpx; }
.time-chip { padding: 9rpx 14rpx; border-radius: 999rpx; background: #fff4cf; color: #8a6815; }
.schedule { margin-top: 20rpx; padding: 22rpx; border-radius: 24rpx; background: #fff4cf; }
.schedule-deadline, .schedule-advisory { background: #f9e4d3; }
.schedule-condition { background: #f2f4f1; }
.schedule-pending { background: #f2f4f1; }
.schedule-before { background: #f2f4f1; opacity: .76; }
.schedule-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.schedule-label { color: #8a6815; font-size: 20rpx; font-weight: 700; }
.schedule-deadline .schedule-label, .schedule-advisory .schedule-label { color: #9f5f34; }
.schedule-date { color: #5c4638; font-size: 24rpx; font-weight: 700; text-align: right; }
.schedule-summary { margin-top: 10rpx; color: #8d7e73; font-size: 21rpx; line-height: 1.6; }
.material-hint { margin-top: 18rpx; color: #a7ada6; font-size: 20rpx; }
.notice-card { margin-top: 42rpx; padding: 32rpx; border-radius: 30rpx; background: linear-gradient(145deg, #fff5e9 0%, #f2f4f1 100%); box-shadow: 0 12rpx 34rpx rgba(32,35,31,.035); }
.notice-title { color: #614b3d; font-size: 27rpx; font-weight: 650; }
.notice-line { position: relative; margin-top: 16rpx; padding-left: 22rpx; color: #8d7e73; font-size: 23rpx; line-height: 1.7; }
.notice-line::before { content: ""; position: absolute; left: 0; top: 15rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #e8a87c; }
.disclaimer { margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.55); color: #6f756e; font-size: 22rpx; line-height: 1.7; }
.website-card { margin-top: 26rpx; padding: 30rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-radius: 30rpx; background: #ffffff; box-shadow: 0 14rpx 40rpx rgba(32,35,31,.04); }
.website-icon { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 22rpx; background: #fff4cf; color: #735711; font-size: 19rpx; font-weight: 700; flex: none; }
.website-card > view:nth-child(2) { min-width: 0; flex: 1; }
.website-kicker { color: #8a6815; font-size: 20rpx; font-weight: 650; }
.website-title { margin-top: 8rpx; color: #424741; font-size: 28rpx; font-weight: 650; }
.website-copy { margin-top: 8rpx; color: #969c95; font-size: 21rpx; line-height: 1.5; }
.website-arrow { color: #8a6815; font-size: 38rpx; }
.source-note { margin-top: 24rpx; color: #a7ada6; font-size: 20rpx; text-align: center; }
.drawer-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(72,54,43,.35); opacity: 0; transition: opacity 200ms cubic-bezier(.23,1,.32,1); }
.detail-drawer { width: 100%; max-height: 88vh; box-sizing: border-box; border-radius: 40rpx 40rpx 0 0; background: #faf6f0; overflow: hidden; transform: translateY(100%); transition: transform 260ms cubic-bezier(.32,.72,0,1); }
.drawer-mask.is-open { opacity: 1; }
.drawer-mask.is-open .detail-drawer { transform: translateY(0); }
.drawer-handle { width: 74rpx; height: 8rpx; margin: 16rpx auto 8rpx; border-radius: 999rpx; background: #e4d5c8; }
.drawer-head { padding: 18rpx 30rpx 24rpx; display: flex; align-items: flex-start; gap: 20rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(32,35,31,.03); }
.drawer-head > view:first-child { flex: 1; min-width: 0; }
.drawer-kicker { color: #8a6815; font-size: 20rpx; font-weight: 700; }
.drawer-title { margin-top: 8rpx; color: #424741; font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.drawer-close { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff4cf; color: #8a6815; font-size: 38rpx; }
.drawer-scroll { height: 68vh; box-sizing: border-box; padding: 28rpx 30rpx 60rpx; }
.detail-schedule { padding: 24rpx; border-radius: 26rpx; background: #fff4cf; }
.detail-block { margin-top: 24rpx; padding: 26rpx; border-radius: 28rpx; background: #ffffff; box-shadow: 0 10rpx 30rpx rgba(32,35,31,.035); }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.detail-grid .detail-block { min-width: 0; }
.detail-label { display: block; color: #a2968d; font-size: 20rpx; font-weight: 600; }
.detail-value { margin-top: 10rpx; color: #424741; font-size: 25rpx; line-height: 1.65; }
.material-warning { margin-top: 10rpx; color: #a5683f; font-size: 21rpx; line-height: 1.55; }
.material-item, .note-item { position: relative; margin-top: 14rpx; padding-left: 22rpx; color: #6f756e; font-size: 24rpx; line-height: 1.6; }
.material-item::before, .note-item::before { content: ""; position: absolute; left: 0; top: 15rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #e8a87c; }
.detail-nav { margin: 26rpx 0 50rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.detail-nav > view { padding: 24rpx; border-radius: 26rpx; background: #f2f4f1; min-width: 0; }
.nav-text { display: block; margin-top: 10rpx; color: #6a594e; font-size: 22rpx; line-height: 1.5; }
@media (prefers-reduced-motion: reduce) {
  .calculate-button, .stage-item, .node-card { transition-property: background-color; }
  .calculate-button:active, .stage-item:active, .timeline-row:active .node-card { transform: none; }
  .drawer-mask { transition: opacity 160ms ease; }
  .detail-drawer { transform: translateY(0); transition: opacity 160ms ease; opacity: 0; }
  .drawer-mask.is-open .detail-drawer { opacity: 1; }
}

/* Oil visual system; business data and timeline rules stay unchanged. */
.page-title, .section-title { color: #20231f; }
.page-subtitle { color: #6f756e; }
.input-card { border: 1rpx solid #e4e8e2; border-top: 4rpx solid #e7b93f; border-radius: 18rpx; background: #ffffff; }
.input-label { color: #5f4a10; }
.selector-value, .date-value { border: 1rpx solid #e8e2d6; border-radius: 12rpx; background: rgba(255,255,255,.88); box-shadow: none; color: #2f332e; }
.selector-order, .section-index { border-radius: 9rpx; background: #e7b93f; color: #4f3d0d; }
.date-value.selected { border-color: #d6b14a; background: #fff4cf; color: #5f4a10; }
.calculate-button { border: 1rpx solid #e1c56d; border-radius: 14rpx; background: #fff4cf; color: #735711; box-shadow: none; }
.calculate-button:active { background: #f6e6ad; }
.summary-card { border: 1rpx solid #e4e8e2; border-top: 4rpx solid #e7b93f; border-radius: 18rpx; background: #ffffff; color: #20231f; box-shadow: none; }
.summary-kicker, .summary-date, .stat-label { color: #6f756e; }
.summary-stats { border-radius: 12rpx; background: #f2f4f1; }
.full-toggle, .time-chip { border-radius: 8rpx; background: #fff4cf; color: #735711; }
.stage-item { border: 1rpx solid #e4e8e2; border-radius: 14rpx; background: #fff; box-shadow: none; }
.stage-item.active { border-color: #d6b14a; background: #fff4cf; color: #4f3d0d; box-shadow: none; }
.timeline-dot { border: 1rpx solid #e4ded3; border-radius: 9rpx; background: #f2f4f1; color: #6f756e; box-shadow: none; }
.timeline-dot.status-known, .timeline-dot.status-earliest, .timeline-dot.status-reference, .timeline-dot.status-deadline, .timeline-dot.status-advisory { background: #e7b93f; color: #4f3d0d; }
.timeline-line { background: #e4e8e2; }
.node-card, .notice-card, .website-card, .detail-block { border: 1rpx solid #e4e8e2; border-radius: 16rpx; background: #fff; box-shadow: none; }
.schedule, .detail-schedule { border-left: 4rpx solid #e7b93f; border-radius: 12rpx; background: #f2f4f1; }
.notice-card { border-color: #e4e8e2; background: #ffffff; }
.disclaimer { border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #f2f4f1; }
.website-icon { border-radius: 10rpx; background: #fff4cf; }
.detail-drawer { border-radius: 20rpx 20rpx 0 0; background: #f8f9f7; }
.drawer-head { background: #fff; box-shadow: none; }
.drawer-close { border-radius: 10rpx; background: #fff4cf; }
.detail-nav > view { border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #ffffff; }
