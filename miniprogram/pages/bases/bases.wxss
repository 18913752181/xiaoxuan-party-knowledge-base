.directory-page { padding-bottom: 160rpx; }
.load-error { margin-top: 30rpx; padding: 36rpx; color: #a7603c; font-size: 26rpx; line-height: 1.7; }
.directory-hero { padding: 34rpx; background: linear-gradient(145deg, #fff9f1, #f7e8d7); }
.directory-hero .page-title { margin-top: 10rpx; font-size: 46rpx; }
.directory-hero .page-subtitle { margin-top: 12rpx; font-size: 25rpx; }
.hero-row { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; }
.hero-number { color: #b96d39; font-size: 42rpx; font-weight: 700; }
.hero-unit { margin-left: 10rpx; color: #8b7566; font-size: 22rpx; }
.route-link { margin: 0; padding: 14rpx 19rpx; border-radius: 999rpx; background: rgba(255,253,250,.8); color: #b96d39; font-size: 23rpx; }
.route-link, .view-option, .filter-chip, .area-chip, .base-card, .selected-place, .more-button { transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.route-link:active, .filter-chip:active, .area-chip:active, .base-card:active, .selected-place:active, .more-button:active { transform: scale(.98); }
.view-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-top: 24rpx; padding: 8rpx; border-radius: 999rpx; box-shadow: 0 10rpx 28rpx rgba(142,101,66,.06); }
.view-option { padding: 16rpx 20rpx; border-radius: 999rpx; color: #978b82; font-size: 24rpx; text-align: center; }
.view-option:active { transform: scale(.97); }
.view-option.is-active { background: #fff0e4; color: #b96d39; font-weight: 650; }
.map-card { margin-top: 24rpx; overflow: hidden; padding: 24rpx; }
.map-heading { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 4rpx 20rpx; }
.map-title { color: #51443b; font-size: 30rpx; font-weight: 700; }
.map-subtitle { margin-top: 7rpx; color: #a08f82; font-size: 21rpx; }
.map-badge { padding: 9rpx 15rpx; border-radius: 999rpx; background: #fff0e4; color: #bd6d38; font-size: 20rpx; }
.education-map { width: 100%; height: 500rpx; overflow: hidden; border-radius: 28rpx; }
.map-empty { display: flex; align-items: center; justify-content: center; flex-direction: column; min-height: 360rpx; padding: 36rpx; border-radius: 28rpx; background: #faf3ec; text-align: center; }
.map-empty-icon { color: #d39a72; font-size: 48rpx; }
.map-empty-title { margin-top: 18rpx; color: #66574d; font-size: 27rpx; font-weight: 650; }
.map-empty-copy { margin-top: 10rpx; color: #9b8e84; font-size: 23rpx; line-height: 1.6; }
.selected-place { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; padding: 18rpx; border-radius: 25rpx; background: #fff7ef; }
.selected-logo { flex: none; width: 62rpx; height: 62rpx; border-radius: 20rpx; }
.selected-content { min-width: 0; flex: 1; }
.selected-name { overflow: hidden; color: #58473c; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.selected-address { overflow: hidden; margin-top: 6rpx; color: #9b8c81; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.selected-arrow { color: #c37a47; font-size: 38rpx; }
.map-note { padding: 17rpx 5rpx 0; color: #a09287; font-size: 20rpx; line-height: 1.65; }
.verified-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #e8a87c; }
.search-card { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding: 0 26rpx; height: 88rpx; }
.search-card input { min-width: 0; flex: 1; font-size: 27rpx; }
.search-icon, .clear-search { color: #bb7a4b; font-size: 36rpx; line-height: 1; }
.clear-search { padding: 10rpx; }
.placeholder { color: #b6aaa0; }
.filter-scroll { margin: 22rpx -32rpx 0; white-space: nowrap; }
.area-scroll { margin-top: 14rpx; }
.filter-row { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.filter-chip, .area-chip { padding: 14rpx 20rpx; border-radius: 999rpx; background: #fffdfa; color: #806f63; font-size: 23rpx; box-shadow: 0 8rpx 20rpx rgba(142,101,66,.05); }
.filter-chip.is-active { background: #e8a87c; color: #fffaf5; }
.area-chip.is-active { background: #fff0e4; color: #b96d39; }
.list-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; color: #706158; font-size: 25rpx; }
.count { color: #b96d39; font-size: 32rpx; font-weight: 700; }
.list-note { color: #aaa097; font-size: 20rpx; }
.base-list { margin-top: 18rpx; }
.base-card { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 24rpx; }
.base-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 25rpx; background: #fff0e4; color: #c77c43; font-size: 32rpx; }
.base-content { min-width: 0; flex: 1; }
.base-name { overflow: hidden; color: #51443b; font-size: 28rpx; font-weight: 650; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.base-meta { overflow: hidden; margin-top: 8rpx; color: #978b82; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.base-tags { display: flex; gap: 10rpx; margin-top: 13rpx; }
.base-tags text { padding: 5rpx 11rpx; border-radius: 999rpx; background: #faf1e8; color: #ad7a55; font-size: 18rpx; }
.base-tags .location-tag { background: #f3f0ec; color: #a49a92; }
.base-tags .location-tag.is-verified { background: #fff0e4; color: #b96d39; }
.card-arrow { color: #c7b2a1; font-size: 42rpx; }
.more-button { display: block; width: 100%; margin-top: 20rpx; padding: 22rpx; border-radius: 999rpx; background: #fff0e4; color: #b96d39; font-size: 24rpx; }
.reset-filter { width: 100%; margin-top: 28rpx; }
@media (prefers-reduced-motion: reduce) {
  .route-link, .view-option, .filter-chip, .area-chip, .base-card, .selected-place, .more-button { transition-property: background-color; }
  .route-link:active, .view-option:active, .filter-chip:active, .area-chip:active, .base-card:active, .selected-place:active, .more-button:active { transform: none; }
}
