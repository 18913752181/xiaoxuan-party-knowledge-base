<view class="page-shell directory-page">
  <view wx:if="{{loadError}}" class="load-error surface">{{loadError}}</view>
  <block wx:else>
  <view class="directory-hero surface">
    <view class="eyebrow">宣知 · EDUCATION GUIDE</view>
    <view class="page-title">教育基地导航</view>
    <view class="page-subtitle">从已收录的教育现场中，按地区和类型找到适合本次学习活动的点位。</view>
    <view class="hero-row"><view class="hero-note">持续整理 · 信息以点位通知为准</view><view class="hero-actions"><button class="route-link" bindtap="openFavorites">我的收藏</button><button class="route-link" bindtap="openPlan">路线清单</button></view></view>
  </view>
  <view wx:if="{{featuredBase}}" class="featured-base surface" data-id="{{featuredBase.id}}" bindtap="openDetail">
    <image class="featured-image" src="{{featuredBase.featureImage}}" mode="widthFix"></image>
    <view class="featured-copy">
      <view class="featured-kicker">本期推荐 · 主题插画</view>
      <view class="featured-title">{{featuredBase.name}}</view>
      <view class="featured-meta">{{featuredBase.city}} · {{featuredBase.district}} · 点击查看基地详情</view>
    </view>
  </view>
  <view class="search-card surface"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="inputKeyword" placeholder="搜索名称、地区或类型" placeholder-class="placeholder" /><text wx:if="{{keyword}}" class="clear-search" bindtap="clearKeyword">×</text></view>
  <scroll-view class="filter-scroll" scroll-x="true" show-scrollbar="false"><view class="filter-row"><view wx:for="{{types}}" wx:key="*this" class="filter-chip {{activeType === item ? 'is-active' : ''}}" data-value="{{item}}" bindtap="selectType">{{item}}</view></view></scroll-view>
  <view class="region-label">先选择城市</view>
  <scroll-view class="filter-scroll city-scroll" scroll-x="true" show-scrollbar="false"><view class="filter-row"><view wx:for="{{cities}}" wx:key="*this" class="city-chip {{activeCity === item ? 'is-active' : ''}}" data-value="{{item}}" bindtap="selectCity">{{item}}</view></view></scroll-view>
  <block wx:if="{{districts.length}}"><view class="region-label district-label">再选择区县</view><scroll-view class="filter-scroll district-scroll" scroll-x="true" show-scrollbar="false"><view class="filter-row"><view wx:for="{{districts}}" wx:key="*this" class="area-chip {{activeDistrict === item ? 'is-active' : ''}}" data-value="{{item}}" bindtap="selectDistrict">{{item}}</view></view></scroll-view></block>
  <view class="view-switch surface"><view class="view-option {{viewMode === 'list' ? 'is-active' : ''}}" data-mode="list" bindtap="switchView">列表</view><view class="view-option {{viewMode === 'map' ? 'is-active' : ''}}" data-mode="map" bindtap="switchView">地图</view></view>
  <view wx:if="{{viewMode === 'map'}}" class="map-card surface">
    <view class="map-heading"><view class="map-subtitle">查看当前筛选范围内的公开位置</view><view class="map-badge">地图</view></view>
    <map wx:if="{{mappedFilteredTotal}}" id="educationMap" class="education-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="8" markers="{{markers}}" bindmarkertap="selectMarker" enable-zoom="true" enable-scroll="true" show-location="false"></map>
    <view wx:else class="map-empty"><text class="map-empty-icon">⌖</text><text class="map-empty-title">当前筛选结果暂无已核实位置</text><text class="map-empty-copy">可以切换到列表查看全部匹配基地。</text></view>
    <view wx:if="{{selectedBase}}" class="selected-place" data-id="{{selectedBase.id}}" bindtap="openDetail">
      <image class="selected-logo" src="/assets/education-map-logo.jpg" mode="aspectFill"></image>
      <view class="selected-content"><view class="selected-name">{{selectedBase.name}}</view><view class="selected-address">{{selectedBase.location.address}}</view></view>
      <text class="selected-arrow">›</text>
    </view>
    <view class="map-note"><text class="verified-dot"></text>已核实公开位置的点位会显示在地图中；其余点位仅在列表中展示。</view>
  </view>
  <view class="list-heading"><text>教育现场</text><text class="list-note">按当前筛选展示</text></view>
  <view wx:if="{{total && viewMode === 'list'}}" class="base-list"><view wx:for="{{bases}}" wx:key="id" class="base-card surface {{item.featureImage ? 'has-base-image' : ''}}" data-id="{{item.id}}" bindtap="openDetail"><image wx:if="{{item.featureImage}}" class="base-image" src="{{item.thumbnailImageUrl || item.featureImage}}" mode="aspectFill" aria-label="{{item.imageAlt || item.name}}"></image><view wx:else class="base-icon">{{item.icon}}</view><view class="base-content"><view class="base-name">{{item.name}}</view><view class="base-meta">⌖ {{item.city}} · {{item.district}} · {{item.type}}</view><view class="base-tags"><text>{{item.status}}</text><text class="location-tag {{item.location ? 'is-verified' : ''}}">{{item.locationStatus}}</text></view></view><text class="card-arrow">›</text></view><button wx:if="{{hasMore}}" class="more-button" bindtap="loadMore">继续加载更多基地</button></view>
  <x-empty-state wx:if="{{!total}}" icon="⌕" title="没有找到匹配的基地" description="可以换个关键词，或清除地区和类型筛选。"><button class="secondary-button reset-filter" bindtap="resetFilters">清除筛选</button></x-empty-state>
  </block>
</view>
<x-tabbar active="bases"></x-tabbar>
