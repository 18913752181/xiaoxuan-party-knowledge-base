page { background-color: #f8f9f7; }
.board-page { min-height: 100vh; color: #20231f; }
.board-shell { padding: 40rpx 32rpx 178rpx; }
.hero-kicker, .section-kicker { color: #8b857a; font-size: 19rpx; font-weight: 700; letter-spacing: 2.5rpx; }
.hero-row, .section-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.hero-title { margin-top: 14rpx; color: #20231f; font-size: 50rpx; font-weight: 760; line-height: 1.2; letter-spacing: -2rpx; }
.hero-subtitle { max-width: 500rpx; margin-top: 14rpx; color: #6f756e; font-size: 25rpx; line-height: 1.7; }
.member-tag { flex: none; margin-top: 16rpx; padding: 9rpx 13rpx; border: 1rpx solid #e4e8e2; border-radius: 8rpx; background: #fff4cf; color: #735711; font-size: 19rpx; font-weight: 650; }
.progress-card { margin-top: 32rpx; padding: 30rpx; border: 1rpx solid #e4e8e2; border-top: 4rpx solid #e7b93f; border-radius: 18rpx; background: #ffffff; box-shadow: none; }
.section-title { margin-top: 8rpx; color: #20231f; font-size: 31rpx; font-weight: 720; }
.progress-mark, .calendar-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border: 1rpx solid rgba(41,39,34,.12); border-radius: 12rpx; background: rgba(255,255,255,.54); color: #4b401f; font-size: 26rpx; }
.progress-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28rpx; border-top: 1rpx solid rgba(41,39,34,.13); }
.progress-item { display: flex; padding: 24rpx 8rpx 2rpx; flex-direction: column; }
.progress-item + .progress-item { padding-left: 22rpx; border-left: 1rpx solid rgba(41,39,34,.13); }
.progress-number { color: #20231f; font-size: 42rpx; font-weight: 780; line-height: 1; }
.progress-label { margin-top: 10rpx; color: rgba(41,39,34,.63); font-size: 20rpx; }
.today-section, .task-section, .create-card, .binding-card, .state-card { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #e4e8e2; border-radius: 18rpx; background: #ffffff; box-shadow: none; }
.state-card { color: #6f6a61; font-size: 24rpx; line-height: 1.7; text-align: center; }
.error-card { color: #8a554d; }
.binding-copy { margin-top: 18rpx; color: #6f756e; font-size: 23rpx; line-height: 1.7; }
.binding-input, .task-input { box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 24rpx; padding: 0 24rpx; border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #f2f4f1; color: #2f332e; font-size: 26rpx; }
.binding-input { font-size: 36rpx; font-weight: 720; letter-spacing: 10rpx; text-align: center; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 20rpx; border: 1rpx solid #e1c56d; border-radius: 12rpx; background: #fff4cf; color: #735711; font-size: 25rpx; font-weight: 680; line-height: 1; }
.primary-button[disabled] { border-color: #e4e8e2; background: #eeeae2; color: #a7ada6; }
.secondary-button { width: 220rpx; height: 70rpx; margin: 20rpx auto 0; border-color: #e4e8e2; font-size: 23rpx; }
.schedule-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 14rpx; }
.schedule-picker { padding: 22rpx; border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #f2f4f1; color: #424741; font-size: 23rpx; text-align: center; }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin-top: 26rpx; }
.date-scroll { width: 100%; margin-top: 26rpx; white-space: nowrap; }
.month-row { display: inline-flex; gap: 10rpx; padding: 0 2rpx 8rpx; }
.date-cell { position: relative; display: flex; align-items: center; justify-content: center; min-height: 116rpx; border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #f2f4f1; color: #6f756e; flex-direction: column; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.month-row .date-cell { width: 94rpx; min-height: 108rpx; flex: none; }
.date-cell:active { transform: scale(.97); }
.date-cell.is-selected { border-color: #c89518; background: #e7b93f; color: #20231f; }
.weekday { font-size: 20rpx; }
.day-number { margin-top: 8rpx; font-size: 26rpx; font-weight: 720; }
.today-dot { position: absolute; bottom: 9rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: #20231f; }
.calendar-mark { border-color: #e4e8e2; background: #fff4cf; color: #735711; }
.task-count { margin-top: 14rpx; color: #8b857a; font-size: 21rpx; }
.reminder-list { margin-top: 22rpx; border-top: 1rpx solid #e4e8e2; }
.reminder-swipe { position: relative; overflow: hidden; background: #a64f45; }
.reminder-swipe + .reminder-swipe { border-top: 1rpx solid #e4e8e2; }
.reminder-row { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx 0; background: #ffffff; transition: transform 180ms cubic-bezier(.23,1,.32,1); }
.reminder-row.is-swiped { transform: translateX(-128rpx); }
.delete-action { position: absolute; z-index: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 128rpx; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: #a64f45; color: #ffffff; font-size: 23rpx; font-weight: 650; line-height: 1; }
.delete-action::after { border: 0; }
.reminder-check { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 2rpx; border: 2rpx solid #c9c2b6; border-radius: 7rpx; color: #5e4b12; font-size: 20rpx; font-weight: 750; }
.reminder-check.can-check { border-color: #b6bcb5; background: #ffffff; }
.reminder-check.can-check:active { border-color: #c89518; background: #fff4cf; }
.reminder-row.is-done .reminder-check { border-color: #e0ba4d; background: #e7b93f; }
.reminder-row.is-done .reminder-content { color: #928d84; text-decoration: line-through; }
.reminder-main { min-width: 0; flex: 1; }
.reminder-content { color: #2f332e; font-size: 26rpx; font-weight: 620; line-height: 1.55; }
.reminder-meta { margin-top: 8rpx; color: #969c95; font-size: 20rpx; }
.reminder-detail { margin-top: 7rpx; color: #a7ada6; font-size: 19rpx; line-height: 1.5; }
.task-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.task-action { min-width: 112rpx; height: 58rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid #e4e8e2; border-radius: 10rpx; background: #fff4cf; color: #735711; font-size: 21rpx; line-height: 56rpx; }
.complete-action { border-color: #e1c56d; background: #fff4cf; color: #735711; }
.empty-state { display: flex; align-items: center; padding: 34rpx 18rpx 22rpx; flex-direction: column; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 1rpx solid #e4e8e2; border-radius: 14rpx; background: #fff4cf; color: #735711; font-size: 34rpx; font-weight: 760; }
.empty-title { margin-top: 4rpx; color: #2f332e; font-size: 28rpx; font-weight: 700; }
.empty-copy { max-width: 480rpx; margin-top: 12rpx; color: #8b857b; font-size: 22rpx; line-height: 1.7; }
.sync-note { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 24rpx; padding: 0 4rpx; color: #989289; font-size: 20rpx; line-height: 1.65; }
.sync-dot { width: 10rpx; height: 10rpx; margin-top: 11rpx; border-radius: 50%; background: #c89518; flex: none; }
@media (prefers-reduced-motion: reduce) {
  .date-cell, .reminder-row { transition-property: background-color; }
  .date-cell:active { transform: none; }
  .reminder-row.is-swiped { transform: translateX(-128rpx); }
}

