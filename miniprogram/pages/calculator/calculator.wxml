<view class="page-shell calculator-page">
  <view class="eyebrow">入党时间核算</view>
  <view class="page-title">填写已经发生的日期</view>
  <view class="page-subtitle">除申请书日期外，其余节点按实际进度选填。请按阶段顺序填写，不要填写计划中的未来日期。</view>

  <view class="form-card surface">
    <view wx:for="{{fields}}" wx:key="key" class="date-field">
      <view class="field-order">{{item.order}}</view>
      <view class="field-main">
        <view class="field-label-row">
          <view class="field-label">{{item.label}}</view>
          <view class="field-tag {{item.required ? 'required' : ''}}">{{item.required ? '必填' : '选填'}}</view>
        </view>
        <view class="field-control-row">
          <picker class="date-picker" mode="date" value="{{item.value}}" end="{{maxDate}}" data-key="{{item.key}}" bindchange="selectDate">
            <view class="date-value {{item.value ? 'selected' : ''}}">{{item.value ? item.value : '请选择日期'}}</view>
          </picker>
          <view wx:if="{{item.value}}" class="clear-date" data-key="{{item.key}}" catchtap="clearDate">清除</view>
        </view>
      </view>
    </view>
  </view>

  <view class="input-notice">
    <view class="notice-title">日期口径</view>
    <view class="notice-line">“接收预备党员”填写党支部党员大会通过日期。</view>
    <view class="notice-line">“转为正式党员”填写正式党员身份的生效日期，不填党委批复日期。</view>
  </view>

  <button class="primary-button submit-button" bindtap="submit">查看核算结果</button>
  <button wx:if="{{hasSavedValues}}" class="reset-button" bindtap="resetForm">清空全部日期</button>
</view>
