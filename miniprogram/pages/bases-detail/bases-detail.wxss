.detail-page { padding-bottom: 70rpx; }
.detail-hero { position: relative; overflow: hidden; padding: 36rpx; min-height: 278rpx; background: linear-gradient(145deg, #fff4e8, #f2dfca); }
.detail-symbol { position: absolute; right: 30rpx; bottom: 24rpx; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 38rpx; background: rgba(255,253,250,.66); color: #c77c43; font-size: 52rpx; transform: rotate(-6deg); }
.detail-type { display: inline-flex; padding: 10rpx 16rpx; border-radius: 999rpx; background: rgba(255,253,250,.72); color: #a6673f; font-size: 22rpx; }
.detail-title { max-width: 510rpx; margin-top: 24rpx; color: #4b3b30; font-size: 41rpx; font-weight: 700; line-height: 1.35; }
.detail-status { display: flex; align-items: center; gap: 9rpx; margin-top: 18rpx; color: #806f63; font-size: 24rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e8a87c; }
.info-row { display: flex; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f2e9e1; color: #675b53; font-size: 25rpx; line-height: 1.7; }
.info-row:last-child { border-bottom: 0; }
.info-row > text { flex: none; width: 122rpx; color: #aa9688; }
.info-row > view { flex: 1; }
.is-muted { color: #aa9f97 !important; }
.location-source { margin-top: 16rpx; color: #ab9d92; font-size: 20rpx; }
.map-button { width: 100%; margin-top: 18rpx; padding: 19rpx; border-radius: 999rpx; background: #fff0e4; color: #b96d39; font-size: 24rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.map-button:active { transform: scale(.97); }
.map-button.is-disabled { background: #f4f0ec; color: #a9a09a; }
.contact-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 22rpx; background: #fff9f3; color: #b96d39; font-size: 22rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.contact-card:active { background: #fff3e9; transform: scale(.98); }
.contact-card > view { min-width: 0; flex: 1; }
.contact-label, .contact-value { display: block; }
.contact-label { color: #927e70; font-size: 21rpx; }
.contact-value { overflow: hidden; margin-top: 7rpx; color: #5f5148; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.source-card { background: #f8f0e7; }
.notice { margin-top: 20rpx; color: #9b8d82; font-size: 22rpx; line-height: 1.7; }
.soft-card { background: #fff8f1; }
.tip-line { margin-top: 17rpx; color: #7d6c61; font-size: 24rpx; line-height: 1.7; }
.detail-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.action-half { flex: 1; min-width: 0; font-size: 26rpx; }
.favorite-button.is-active { background: #fff0e4; color: #a96134; }
.route-text-button { width: 100%; margin-top: 18rpx; color: #b96d39; font-size: 24rpx; }
@media (prefers-reduced-motion: reduce) {
  .map-button, .contact-card { transition-property: background-color; }
  .map-button:active, .contact-card:active { transform: none; }
}
