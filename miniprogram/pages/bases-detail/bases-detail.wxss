.detail-page { padding-bottom: 70rpx; }
.detail-hero { position: relative; overflow: hidden; padding: 36rpx; min-height: 278rpx; background: linear-gradient(145deg, #fff4e8, #f2dfca); }
.detail-hero.has-feature-image { padding: 0; }
.detail-feature-image { display: block; width: 100%; height: auto; background: #f3eee4; }
.detail-image-caption { position: absolute; top: 22rpx; right: 22rpx; padding: 9rpx 14rpx; border: 1rpx solid rgba(32,35,31,.12); border-radius: 8rpx; background: rgba(255,255,255,.88); color: #6f756e; font-size: 18rpx; font-weight: 650; }
.detail-hero-copy { position: relative; }
.has-feature-image .detail-hero-copy { padding: 30rpx 32rpx 32rpx; }
.has-feature-image .detail-title { max-width: none; margin-top: 18rpx; }
.detail-symbol { position: absolute; right: 30rpx; bottom: 24rpx; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 38rpx; background: rgba(255,253,250,.66); color: #8a6815; font-size: 52rpx; transform: rotate(-6deg); }
.detail-type { display: inline-flex; padding: 10rpx 16rpx; border-radius: 999rpx; background: rgba(255,253,250,.72); color: #8a6815; font-size: 22rpx; }
.detail-title { max-width: 510rpx; margin-top: 24rpx; color: #424741; font-size: 41rpx; font-weight: 700; line-height: 1.35; }
.detail-status { display: flex; align-items: center; gap: 9rpx; margin-top: 18rpx; color: #806f63; font-size: 24rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e8a87c; }
.info-row { display: flex; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e4e8e2; color: #675b53; font-size: 25rpx; line-height: 1.7; }
.info-row:last-child { border-bottom: 0; }
.info-row > text { flex: none; width: 122rpx; color: #aa9688; }
.info-row > view { flex: 1; }
.is-muted { color: #aa9f97 !important; }
.location-source { margin-top: 16rpx; color: #ab9d92; font-size: 20rpx; }
.map-button { width: 100%; margin-top: 18rpx; padding: 19rpx; border-radius: 999rpx; background: #fff4cf; color: #8a6815; font-size: 24rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.map-button:active { transform: scale(.97); }
.map-button.is-disabled { background: #f2f4f1; color: #a9a09a; }
.contact-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 22rpx; border-radius: 22rpx; background: #ffffff; color: #8a6815; font-size: 22rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.contact-card:active { background: #fff3e9; transform: scale(.98); }
.contact-card > view { min-width: 0; flex: 1; }
.contact-label, .contact-value { display: block; }
.contact-label { color: #927e70; font-size: 21rpx; }
.contact-value { overflow: hidden; margin-top: 7rpx; color: #424741; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.source-card { background: #f2f4f1; }
.notice { margin-top: 20rpx; color: #969c95; font-size: 22rpx; line-height: 1.7; }
.guide-card { background: #ffffff; }
.guide-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 22rpx; }
.guide-summary > view { min-width: 0; padding: 20rpx; border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #f2f4f1; }
.guide-label, .guide-value { display: block; }
.guide-label { color: #969c95; font-size: 20rpx; }
.guide-value { margin-top: 10rpx; color: #2f332e; font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.guide-fee { color: #735711; }
.guide-note { margin-top: 16rpx; padding: 20rpx; border-radius: 12rpx; background: #f2f4f1; color: #6f756e; font-size: 23rpx; line-height: 1.7; }
.guide-foot { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; color: #a7ada6; font-size: 19rpx; }
.guide-source { flex: none; color: #735711; }
.soft-card { background: #ffffff; }
.tip-line { margin-top: 17rpx; color: #6f756e; font-size: 24rpx; line-height: 1.7; }
.detail-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.action-half { flex: 1; min-width: 0; font-size: 26rpx; }
.favorite-button.is-active { background: #fff4cf; color: #8a6815; }
.route-text-button { width: 100%; margin-top: 18rpx; color: #8a6815; font-size: 24rpx; }
.member-guide-card { position: relative; overflow: hidden; border-color: #eadfbf; background: linear-gradient(150deg, #fffdf7, #fff8df); }
.member-guide-card::before { position: absolute; top: 0; right: 0; width: 180rpx; height: 180rpx; border-radius: 50%; background: rgba(244,207,102,.18); content: ""; transform: translate(42%, -50%); }
.member-guide-card.is-unlocked { background: #fff; }
.member-guide-head { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.member-kicker { margin-bottom: 9rpx; color: #9d7a1f; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.member-badge { flex: none; padding: 9rpx 14rpx; border: 1rpx solid #e9d593; border-radius: 8rpx; background: #fff4cf; color: #735711; font-size: 19rpx; font-weight: 650; }
.guide-state { position: relative; margin-top: 26rpx; padding: 30rpx 22rpx; border-radius: 12rpx; background: rgba(255,255,255,.72); color: #8d877c; font-size: 23rpx; line-height: 1.7; text-align: center; }
.guide-error { color: #94615b; }
.guide-retry { display: inline-flex; width: auto; margin-top: 16rpx; padding: 12rpx 24rpx; border: 1rpx solid #e1d7c6; border-radius: 10rpx; background: #fff; color: #5e5549; font-size: 22rpx; }
.locked-copy { position: relative; margin-top: 24rpx; color: #6f675d; font-size: 24rpx; line-height: 1.8; }
.benefit-list { position: relative; margin-top: 22rpx; padding: 4rpx 22rpx; border-radius: 12rpx; background: rgba(255,255,255,.72); }
.benefit-row { display: flex; align-items: center; gap: 15rpx; padding: 18rpx 0; border-bottom: 1rpx solid #ede5d4; color: #5f594f; font-size: 23rpx; }
.benefit-row:last-child { border-bottom: 0; }
.benefit-mark { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border-radius: 50%; background: #f4cf66; color: #3c3426; font-size: 19rpx; font-weight: 800; }
.unlock-button { position: relative; width: 100%; margin-top: 24rpx; padding: 21rpx; border-radius: 12rpx; background: #f4cf66; color: #2f2a22; font-size: 26rpx; font-weight: 700; }
.unlock-button:active { background: #eac256; }
.binding-link { position: relative; width: 100%; margin-top: 12rpx; color: #806a35; font-size: 22rpx; }
.guide-group { position: relative; margin-top: 28rpx; }
.guide-group + .guide-group { padding-top: 26rpx; border-top: 1rpx solid #e8e4da; }
.guide-group-title { margin-bottom: 7rpx; color: #343730; font-size: 26rpx; font-weight: 700; }
.member-info-row { display: flex; gap: 20rpx; padding: 21rpx 0; border-bottom: 1rpx solid #ece9e1; font-size: 23rpx; line-height: 1.7; }
.member-info-row > text { flex: none; width: 126rpx; color: #999186; }
.member-info-row > view { flex: 1; color: #4e514b; white-space: pre-wrap; word-break: break-all; }
.guide-long-text { margin-top: 18rpx; padding: 20rpx; border-radius: 12rpx; background: #f6f5f0; color: #686b64; font-size: 22rpx; line-height: 1.75; white-space: pre-wrap; }
.guide-source-actions { position: relative; margin-top: 25rpx; padding-top: 22rpx; border-top: 1rpx solid #e8e4da; }
.source-status { color: #969990; font-size: 20rpx; line-height: 1.7; }
.source-copy { width: 100%; margin-top: 13rpx; padding: 17rpx; border: 1rpx solid #e3ddcf; border-radius: 10rpx; background: #faf9f5; color: #735711; font-size: 22rpx; }
@media (prefers-reduced-motion: reduce) {
  .map-button, .contact-card { transition-property: background-color; }
  .map-button:active, .contact-card:active { transform: none; }
}

/* Oil visual system */
.detail-hero { border-color: #e4e8e2; border-top: 4rpx solid #e7b93f; background: #ffffff; }
.detail-hero.has-feature-image { border-top: 0; }
.detail-symbol { border-radius: 12rpx; background: rgba(255,255,255,.64); color: #735711; }
.detail-type { border: 1rpx solid #e4e8e2; border-radius: 8rpx; background: rgba(255,255,255,.55); color: #735711; }
.detail-title { color: #20231f; }
.detail-status, .info-row, .tip-line { color: #6f756e; }
.status-dot { background: #c89518; }
.map-button { border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #fff4cf; color: #735711; }
.contact-card { border: 1rpx solid #e4e8e2; border-radius: 12rpx; background: #fff; color: #735711; }
.source-card, .soft-card { background: #f2f4f1; }
.favorite-button.is-active { background: #fff4cf; color: #735711; }
.route-text-button { color: #735711; }
