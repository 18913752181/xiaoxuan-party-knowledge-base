<view wx:if="{{base}}" class="page-shell detail-page">
  <view class="detail-hero surface {{base.featureImage ? 'has-feature-image' : ''}}">
    <block wx:if="{{base.featureImage}}">
      <image class="detail-feature-image" src="{{base.coverImageUrl || base.featureImage}}" mode="widthFix" aria-label="{{base.imageAlt || base.name}}"></image>
      <view class="detail-image-caption">主题插画</view>
    </block>
    <view class="detail-hero-copy">
      <view wx:if="{{!base.featureImage}}" class="detail-symbol">{{base.icon}}</view>
      <view class="detail-type">{{base.type}} · {{base.city}} · {{base.district}}</view>
      <view class="detail-title">{{base.name}}</view>
      <view class="detail-status"><text class="status-dot"></text>{{base.status}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-heading"><view class="section-index">01</view><view class="section-title">基地信息</view></view>
    <view class="info-row"><text>所在地区</text><view>{{base.city}} · {{base.district}}</view></view>
    <view class="info-row"><text>示范类型</text><view>{{base.type}}</view></view>
    <view class="info-row"><text>具体位置</text><view class="intro {{base.location ? '' : 'is-muted'}}">{{base.location ? base.location.address : '公开位置待核实'}}</view></view>
    <view wx:if="{{base.location}}" class="location-source">定位来源：{{base.location.sourceName}}</view>
    <button class="map-button {{base.location ? '' : 'is-disabled'}}" disabled="{{!base.location}}" bindtap="openLocation">{{base.location ? '在地图中打开' : '位置待核实'}}</button>
    <view class="info-row"><text>简介</text><view class="intro {{base.intro === '示范点信息待补充' ? 'is-muted' : ''}}">{{base.intro}}</view></view>
  </view>

  <view class="section-card member-guide-card {{memberActive ? 'is-unlocked' : ''}}">
    <view class="member-guide-head"><view><view class="member-kicker">EDUCATION BASE GUIDE</view><view class="section-title">教育基地攻略</view></view><view class="member-badge">{{memberActive ? '已解锁' : '会员专享'}}</view></view>

    <view wx:if="{{guideLoading}}" class="guide-state">正在核验会员状态和攻略资料…</view>
    <view wx:elif="{{guideError}}" class="guide-state guide-error"><text>{{guideError}}</text><button class="guide-retry" bindtap="loadMemberGuide">重新加载</button></view>

    <block wx:elif="{{!memberActive}}">
      <view class="locked-copy">会员解锁参观联系、讲解信息、活动路线和配套资料</view>
      <view class="benefit-grid"><view wx:for="{{guidePreview}}" wx:key="title" class="benefit-card"><view class="benefit-name">{{item.title}}</view><view class="benefit-description">{{item.description}}</view><view class="benefit-lock">会员内容</view></view></view>
      <button class="unlock-button" bindtap="openMembership">查看会员权益</button>
      <button wx:if="{{!memberBound}}" class="binding-link" bindtap="openMemberBinding">已经是会员？绑定 Dimmo 账号</button>
    </block>

    <block wx:else>
      <view class="guide-module fact-module">
        <view class="guide-module-head"><view class="guide-module-index">01</view><view><view class="guide-module-title">参观联系</view><view class="guide-module-caption">经核实的基地公开信息</view></view></view>
        <view class="fact-card"><view class="fact-label">联系电话</view><view class="fact-content {{memberGuide.officialFacts.contact ? '' : 'is-muted'}}">{{memberGuide.officialFacts.contact || '待完善'}}</view><button wx:if="{{memberGuide.officialFacts.contact}}" class="inline-action" data-value="{{memberGuide.officialFacts.contact}}" bindtap="copyGuideValue">一键复制</button></view>
        <view class="fact-card"><view class="fact-label">预约方式</view><view class="fact-content {{memberGuide.officialFacts.reservationInfo ? '' : 'is-muted'}}">{{memberGuide.officialFacts.reservationInfo || '待完善'}}</view><button wx:if="{{memberGuide.officialFacts.reservationInfo}}" class="inline-action" data-value="{{memberGuide.officialFacts.reservationInfo}}" bindtap="copyGuideValue">复制预约信息</button></view>
        <view class="fact-note"><text>预约 / 开放提示</text><view class="{{memberGuide.officialFacts.openingInfo ? '' : 'is-muted'}}">{{memberGuide.officialFacts.openingInfo || '待完善'}}</view></view>
      </view>

      <view class="guide-module fact-module">
        <view class="guide-module-head"><view class="guide-module-index">02</view><view><view class="guide-module-title">讲解服务</view><view class="guide-module-caption">经核实的讲解与收费信息</view></view></view>
        <view class="guide-summary-cards">
          <view><text>是否提供讲解</text><text class="guide-strong">{{memberGuide.officialFacts.guidedTour ? (memberGuide.officialFacts.guidedTour.available === true ? '提供讲解' : memberGuide.officialFacts.guidedTour.available === false ? '明确不提供' : '待完善') : '待完善'}}</text></view>
          <view><text>讲解费用 / 场次</text><text class="guide-strong {{memberGuide.officialFacts.guidedTour && memberGuide.officialFacts.guidedTour.fee ? '' : 'is-muted'}}">{{memberGuide.officialFacts.guidedTour && memberGuide.officialFacts.guidedTour.fee ? memberGuide.officialFacts.guidedTour.fee : '待完善'}}</text></view>
        </view>
        <view class="fact-note"><text>预约说明</text><view class="{{memberGuide.officialFacts.guidedTour && memberGuide.officialFacts.guidedTour.note ? '' : 'is-muted'}}">{{memberGuide.officialFacts.guidedTour && memberGuide.officialFacts.guidedTour.note ? memberGuide.officialFacts.guidedTour.note : '待完善'}}</view></view>
      </view>

      <view class="guide-module advice-module">
        <view class="guide-module-head"><view class="guide-module-index">03</view><view><view class="guide-module-title">活动路线</view><view class="guide-module-caption advice-label">宣知整理建议</view></view></view>
        <view class="route-block"><view class="route-block-title">半日路线</view><view wx:if="{{memberGuide.editorialAdvice.routes.halfDay.length}}" class="route-timeline"><view wx:for="{{memberGuide.editorialAdvice.routes.halfDay}}" wx:key="index" wx:for-item="step" class="route-node {{step.baseId ? 'is-link' : ''}}" data-id="{{step.baseId}}" bindtap="openNearbyBase"><view class="route-dot"></view><view class="route-node-body"><view class="route-node-line"><text wx:if="{{step.time}}">{{step.time}}</text><text class="route-node-title">{{step.title}}</text></view><view wx:if="{{step.note}}" class="route-node-note">{{step.note}}</view></view></view></view><view wx:else class="empty-guide">待完善</view></view>
        <view class="route-block"><view class="route-block-title">一日路线</view><view wx:if="{{memberGuide.editorialAdvice.routes.fullDay.length}}" class="route-timeline"><view wx:for="{{memberGuide.editorialAdvice.routes.fullDay}}" wx:key="index" wx:for-item="step" class="route-node {{step.baseId ? 'is-link' : ''}}" data-id="{{step.baseId}}" bindtap="openNearbyBase"><view class="route-dot"></view><view class="route-node-body"><view class="route-node-line"><text wx:if="{{step.time}}">{{step.time}}</text><text class="route-node-title">{{step.title}}</text></view><view wx:if="{{step.note}}" class="route-node-note">{{step.note}}</view></view></view></view><view wx:else class="empty-guide">待完善</view></view>
        <view class="route-block"><view class="route-block-title">可联动的周边基地 / 教学点</view><view wx:if="{{memberGuide.editorialAdvice.routes.nearby.length}}" class="nearby-list"><button wx:for="{{memberGuide.editorialAdvice.routes.nearby}}" wx:key="id" wx:for-item="nearby" class="nearby-card" data-id="{{nearby.id}}" bindtap="openNearbyBase"><text class="nearby-name">{{nearby.name}}</text><text wx:if="{{nearby.note}}" class="nearby-note">{{nearby.note}}</text><text wx:else class="nearby-note">查看基地详情</text></button></view><view wx:else class="empty-guide">{{memberGuide.editorialAdvice.routes.nearbyNote || '待完善'}}</view></view>
        <view wx:if="{{memberGuide.editorialAdvice.routes.note}}" class="route-general-note">{{memberGuide.editorialAdvice.routes.note}}</view>
      </view>

      <view class="guide-module advice-module">
        <view class="guide-module-head"><view class="guide-module-index">04</view><view><view class="guide-module-title">配套方案与资料</view><view class="guide-module-caption">直接关联小宣资料库</view></view></view>
        <view wx:if="{{memberGuide.editorialAdvice.materials.length}}" class="material-list"><button wx:for="{{memberGuide.editorialAdvice.materials}}" wx:key="url" wx:for-item="material" class="material-card" data-url="{{material.url}}" data-title="{{material.title}}" bindtap="openGuideMaterial"><text class="material-name">{{material.title}}</text><text wx:if="{{material.description}}" class="material-description">{{material.description}}</text><text class="material-action">打开资料</text></button></view>
        <view wx:else class="empty-guide">待完善</view>
      </view>

      <view class="guide-module advice-module">
        <view class="guide-module-head"><view class="guide-module-index">05</view><view><view class="guide-module-title">基地使用提示</view><view class="guide-module-caption advice-label">宣知整理建议</view></view></view>
        <view wx:if="{{memberGuide.editorialAdvice.usageTips.length}}" class="usage-tags"><text wx:for="{{memberGuide.editorialAdvice.usageTips}}" wx:key="*this">{{item}}</text></view><view wx:else class="empty-guide">待完善</view>
      </view>

      <view class="guide-source-actions">
        <view class="source-status">事实信息来自后台核验资料；缺失内容不会自动补齐。</view>
        <button wx:if="{{memberGuide.officialFacts.officialSourceUrl}}" class="source-copy" data-value="{{memberGuide.officialFacts.officialSourceUrl}}" bindtap="copyGuideValue">复制官方来源</button>
        <button wx:if="{{memberGuide.officialFacts.guidedTour && memberGuide.officialFacts.guidedTour.sourceUrl}}" class="source-copy" data-value="{{memberGuide.officialFacts.guidedTour.sourceUrl}}" bindtap="copyGuideValue">复制讲解依据</button>
      </view>
    </block>
  </view>

  <view class="detail-actions"><button class="secondary-button action-half favorite-button {{favorite ? 'is-active' : ''}}" bindtap="toggleFavorite">{{favorite ? '♥ 已收藏' : '♡ 收藏基地'}}</button><button class="primary-button action-half" disabled="{{inRoute || routeFull}}" bindtap="addToRoute">{{routeButtonText}}</button></view>
  <button class="route-text-button" bindtap="openPlan">查看我的路线清单 ›</button>
</view>
