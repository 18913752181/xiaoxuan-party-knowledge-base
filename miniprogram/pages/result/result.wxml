<view wx:if="{{result}}" class="page-shell result-page">
  <view class="result-hero status-{{result.status}}">
    <view class="result-emoji">🧭</view>
    <view class="result-kicker">当前阶段</view>
    <view class="stage-name">{{result.stage.name}}</view>
    <view class="status-line">
      <view class="status-dot"></view>
      <text>{{result.statusText}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-heading"><view class="section-index">🧾</view><view class="section-title">核算结果</view></view>
    <view class="subheading">关键时间</view>
    <view class="key-date-list">
      <view wx:for="{{result.keyDates}}" wx:key="label" class="key-date-row">
        <text class="key-label">{{item.label}}</text><text class="key-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{result.intervals.length}}" class="subheading interval-heading">阶段间隔</view>
    <view wx:for="{{result.intervals}}" wx:key="id" class="interval-row {{item.invalid ? 'invalid' : ''}}">
      <view class="interval-route">{{item.fromLabel}} → {{item.toLabel}}</view>
      <view class="interval-value">{{item.duration}}</view>
      <view class="interval-days">{{item.daysText}}</view>
    </view>
  </view>

  <view class="section-card next-card">
    <view class="section-heading"><view class="section-index">✨</view><view class="section-title">下一步提醒</view></view>
    <view class="next-label">下一步工作事项</view>
    <view class="next-action">{{result.advice.action}}</view>
    <view class="time-box">
      <view class="time-box-label">建议办理时间</view>
      <view class="time-box-value">{{result.advice.suggestedTime}}</view>
    </view>
    <view wx:for="{{result.advice.notes}}" wx:key="*this" class="advice-note">{{item}}</view>
  </view>

  <view class="section-card">
    <view class="section-heading"><view class="section-index">💡</view><view class="section-title">注意事项</view></view>
    <view wx:if="{{issueCount}}" class="issue-list">
      <view wx:for="{{result.issues}}" wx:key="title" class="issue issue-{{item.level}}">
        <view class="issue-head">
          <text class="issue-tag">{{item.level === 'error' ? '异常' : '需核对'}}</text>
          <text class="issue-title">{{item.title}}</text>
        </view>
        <view class="issue-detail">{{item.detail}}</view>
      </view>
    </view>
    <view wx:else class="normal-note">已填写日期中未发现明显冲突。仍需核对实际办理程序和材料。</view>

    <view class="caution-list">
      <view class="caution-item">申请后满半年、积极分子满一年及预备期满一年，只代表相应时间参考条件，不能替代组织研究和审批。</view>
      <view class="caution-item">系统不核验谈话、推荐备案、考察记录、公示、政治审查、培训、会议表决和党委审批是否完成。</view>
      <view class="caution-item">发展对象到接收预备党员没有在本工具中设置统一最低间隔，请按实际程序办理。</view>
    </view>
    <view class="disclaimer">{{result.disclaimer}}</view>
    <view class="rule-meta">规则版本 {{ruleMeta.version}} · 核对日期 {{ruleMeta.reviewedAt}}</view>
  </view>

  <view class="section-card resources-card">
    <view class="section-heading"><view class="section-index">📚</view><view class="section-title">相关资料</view></view>
    <view class="resource-intro">完整制度依据、流程说明、模板和常见问题由网站统一维护。</view>
    <view class="flow-resource" bindtap="openFlow"><view class="flow-resource-icon">🗺️</view>
      <view class="resource-main"><view class="resource-title">发展党员全流程</view><view class="resource-copy">查看完整的 51 个办理节点，并从任一已知日期推算后续参考时间</view></view>
      <view class="resource-arrow">→</view>
    </view>
    <view wx:for="{{resources}}" wx:key="id" class="resource-row" data-id="{{item.id}}" bindtap="openResource">
      <view class="resource-main"><view class="resource-title">{{item.title}}</view><view class="resource-copy">{{item.description}}</view></view>
      <view class="resource-arrow">→</view>
    </view>
  </view>

  <button class="secondary-button edit-button" bindtap="editDates">返回修改日期</button>
</view>
