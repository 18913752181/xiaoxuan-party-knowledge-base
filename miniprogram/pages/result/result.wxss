.result-page { padding-top: 24rpx; }
.result-hero { padding: 38rpx 34rpx; border-radius: 28rpx; color: #fff; background: #587566; }
.result-hero.status-review { background: #8a7854; }
.result-hero.status-abnormal { background: #895653; }
.result-kicker { font-size: 23rpx; opacity: .75; }
.stage-name { margin-top: 12rpx; font-size: 44rpx; font-weight: 700; }
.status-line { display: flex; align-items: center; gap: 12rpx; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.2); font-size: 25rpx; }
.status-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #fff; }
.subheading { margin-top: 28rpx; color: #7a847e; font-size: 23rpx; font-weight: 600; }
.key-date-list { margin-top: 12rpx; }
.key-date-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eef0ee; font-size: 25rpx; }
.key-date-row:last-child { border-bottom: 0; }
.key-label { flex: 1; color: #66716b; }
.key-value { flex: 0 0 auto; color: #29352f; font-weight: 600; }
.interval-heading { margin-top: 34rpx; }
.interval-row { display: grid; grid-template-columns: 1fr auto; gap: 8rpx 18rpx; margin-top: 14rpx; padding: 22rpx; border-radius: 18rpx; background: #f4f6f3; }
.interval-row.invalid { background: #f8eded; }
.interval-route { color: #68736d; font-size: 22rpx; }
.interval-value { grid-row: span 2; align-self: center; color: #354b40; font-size: 28rpx; font-weight: 700; }
.interval-days { color: #929994; font-size: 21rpx; }
.next-card { background: #fbfcfa; }
.next-label { margin-top: 28rpx; color: #78827c; font-size: 22rpx; }
.next-action { margin-top: 10rpx; color: #29352f; font-size: 30rpx; font-weight: 650; line-height: 1.6; }
.time-box { margin-top: 24rpx; padding: 24rpx; border-radius: 19rpx; background: #eaf0ec; }
.time-box-label { color: #657a6e; font-size: 21rpx; }
.time-box-value { margin-top: 8rpx; color: #395344; font-size: 26rpx; font-weight: 600; line-height: 1.55; }
.advice-note { position: relative; margin-top: 18rpx; padding-left: 22rpx; color: #6d7771; font-size: 23rpx; line-height: 1.7; }
.advice-note::before { position: absolute; left: 0; top: 16rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #849b8e; content: ""; }
.issue-list { margin-top: 26rpx; }
.issue { margin-top: 14rpx; padding: 22rpx; border-radius: 18rpx; }
.issue-error { background: #f8eded; }
.issue-warning { background: #f6f1e7; }
.issue-head { display: flex; align-items: center; gap: 12rpx; }
.issue-tag { padding: 5rpx 10rpx; border-radius: 8rpx; background: rgba(125,72,67,.11); color: #86534e; font-size: 19rpx; font-weight: 700; }
.issue-warning .issue-tag { background: rgba(135,110,64,.12); color: #826b43; }
.issue-title { color: #3b3f3c; font-size: 25rpx; font-weight: 650; }
.issue-detail { margin-top: 12rpx; color: #70746f; font-size: 23rpx; line-height: 1.65; }
.normal-note { margin-top: 26rpx; padding: 22rpx; border-radius: 18rpx; background: #edf4ef; color: #4f6f5d; font-size: 24rpx; line-height: 1.6; }
.caution-list { margin-top: 26rpx; padding-top: 10rpx; border-top: 1rpx solid #edf0ed; }
.caution-item { position: relative; margin-top: 17rpx; padding-left: 24rpx; color: #68716c; font-size: 23rpx; line-height: 1.7; }
.caution-item::before { position: absolute; left: 0; top: 14rpx; color: #829289; content: "·"; font-size: 30rpx; line-height: 16rpx; }
.disclaimer { margin-top: 26rpx; padding: 24rpx; border-radius: 18rpx; background: #f0f1ef; color: #5f6863; font-size: 23rpx; font-weight: 600; line-height: 1.7; }
.rule-meta { margin-top: 16rpx; color: #979d99; font-size: 20rpx; text-align: right; }
.resource-intro { margin-top: 22rpx; color: #737d77; font-size: 23rpx; line-height: 1.65; }
.resource-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #edf0ed; }
.resource-row:last-child { border-bottom: 0; padding-bottom: 4rpx; }
.resource-main { min-width: 0; flex: 1; }
.resource-title { font-size: 27rpx; font-weight: 650; }
.resource-copy { margin-top: 7rpx; color: #828a85; font-size: 21rpx; line-height: 1.5; }
.resource-arrow { color: #678274; font-size: 32rpx; }
.edit-button { margin-top: 24rpx; }
