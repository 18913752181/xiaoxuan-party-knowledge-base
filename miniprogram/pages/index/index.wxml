<view class="home-page">
  <view class="welcome-section">
    <view class="welcome-copy">
      <view class="welcome-eyebrow">DIMMO 工作搭子</view>
      <view class="welcome-title">{{greeting}}</view>
      <view class="welcome-subtitle">今天的提醒和常用工具，都帮你放在这里了。</view>
    </view>
  </view>

  <view class="today-card" bindtap="openDashboard">
    <view class="today-head">
      <view>
        <view class="today-title">今日喵喵看板</view>
        <view class="today-date">{{todayLabel}}</view>
      </view>
      <view class="today-link">查看全部</view>
    </view>

    <view wx:if="{{dashboardStatus === 'loading'}}" class="summary-loading">
      <view class="skeleton skeleton-wide"></view>
      <view class="skeleton skeleton-short"></view>
    </view>

    <view wx:elif="{{dashboardStatus === 'unbound'}}" class="summary-empty">
      <view class="summary-empty-title">绑定后查看今日提醒</view>
      <view class="summary-empty-copy">你告诉 Dimmo 的事项会同步到这里。</view>
    </view>

    <view wx:elif="{{dashboardStatus === 'error'}}" class="summary-empty">
      <view class="summary-empty-title">今日安排暂时没有同步</view>
      <view class="summary-empty-copy">进入看板后可以重新加载。</view>
    </view>

    <view wx:elif="{{todayTasks.length}}" class="today-list">
      <view wx:for="{{todayTasks}}" wx:key="id" class="today-task {{item.statusClass}}">
        <view class="task-state"></view>
        <view class="task-time">{{item.timeText}}</view>
        <view class="task-title">{{item.title}}</view>
        <view class="task-status">{{item.statusText}}</view>
      </view>
      <view wx:if="{{hiddenTaskCount}}" class="more-summary">还有 {{hiddenTaskCount}} 项，进入看板查看</view>
    </view>

    <view wx:else class="summary-empty">
      <view class="summary-empty-title">今天暂时没有安排</view>
      <view class="summary-empty-copy">有新事项时，我会帮你整理在这里。</view>
    </view>

    <view wx:if="{{dashboardStatus === 'ready'}}" class="today-stats">
      <text>{{todayPendingCount}} 项待完成</text>
      <text>{{todayCompletedCount}} 项已完成</text>
    </view>
  </view>

  <view class="tools-section">
    <view class="tools-head">
      <view class="tools-title">常用工具</view>
      <view class="tools-note">轻点即可打开</view>
    </view>
    <view class="tool-grid">
      <view class="mini-tool" bindtap="openDashboard">
        <view class="tool-icon-wrap honey"><image class="tool-icon" src="/assets/icons/structured3d-v2/next-step-reminder.png" mode="aspectFit" /></view>
        <view class="mini-tool-title">喵喵看板</view>
        <view class="mini-tool-copy">管理提醒事项</view>
      </view>
      <view class="mini-tool" bindtap="startCalculation">
        <view class="tool-icon-wrap caramel"><image class="tool-icon" src="/assets/icons/structured3d-v2/time-calculation.png" mode="aspectFit" /></view>
        <view class="mini-tool-title">发展时间</view>
        <view class="mini-tool-copy">推算后续节点</view>
      </view>
      <view class="mini-tool" bindtap="openBases">
        <view class="tool-icon-wrap cream"><image class="tool-icon" src="/assets/icons/structured3d-v2/education-map.png" mode="aspectFit" /></view>
        <view class="mini-tool-title">教育基地</view>
        <view class="mini-tool-copy">查找教育点位</view>
      </view>
      <view class="mini-tool" bindtap="openMaterials">
        <view class="tool-icon-wrap paper"><image class="tool-icon" src="/assets/icons/structured3d-v2/policy-materials.png" mode="aspectFit" /></view>
        <view class="mini-tool-title">资料库</view>
        <view class="mini-tool-copy">查看模板与专题</view>
      </view>
    </view>
  </view>

  <view class="home-footer">结果仅供工作参考</view>
</view>
<x-tabbar active="home"></x-tabbar>
