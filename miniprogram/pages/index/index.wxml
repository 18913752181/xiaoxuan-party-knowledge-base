<view class="page-shell home-page">
  <view class="brand-mark">宣知 · 工作助手</view>
  <view class="tool-card surface">
    <view class="card-heading"><view><view class="card-category">党员发展</view><view class="tool-title">入党时间核算</view></view><image class="tool-icon" src="/assets/icons/structured3d-v2/time-calculation.png" mode="aspectFit" /></view>
    <view class="tool-description">选择一个已完成节点，填写实际日期，推算后续流程的参考时间。</view>
    <view class="capability-line"><text>核对时间</text><text>判断阶段</text><text>提醒下一步</text></view>
    <button class="entry-button" bindtap="startCalculation"><text>开始核算</text><text class="arrow">→</text></button>
  </view>

  <view class="education-card surface">
    <view class="card-heading"><view><view class="card-category">教育实践</view><view class="education-title">教育基地导航</view></view><image class="tool-icon" src="/assets/icons/structured3d-v2/education-map.png" mode="aspectFit" /></view>
    <view class="education-description">按地区和类型查找教育基地，收藏点位，做好活动筹备。</view>
    <view class="capability-line"><text>查找基地</text><text>收藏点位</text><text>整理路线</text></view>
    <button class="entry-button" bindtap="openBases"><text>进入教育地图</text><text class="arrow">→</text></button>
  </view>

  <view class="home-footer"><text>流程数据 {{version}}</text><text>结果仅供工作参考</text></view>
</view>
<x-tabbar active="home"></x-tabbar>
