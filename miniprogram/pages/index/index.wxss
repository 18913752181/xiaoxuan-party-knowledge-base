page { background: #fbf7ef; }

.home-page { min-height: 100vh; padding: 38rpx 30rpx 170rpx; color: #27241f; }
.welcome-section { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; padding: 10rpx 4rpx 28rpx; }
.welcome-copy { min-width: 0; flex: 1; }
.welcome-eyebrow { color: #9a6439; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.welcome-title { max-width: 520rpx; margin-top: 16rpx; color: #27241f; font-size: 45rpx; font-weight: 760; line-height: 1.34; letter-spacing: -1rpx; }
.welcome-subtitle { margin-top: 14rpx; color: #7c756b; font-size: 24rpx; line-height: 1.65; }
.today-card { padding: 30rpx; border-radius: 20rpx; background: #fff0bd; box-shadow: 0 14rpx 32rpx rgba(112, 77, 31, .08); transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.today-card:active { background: #f9e8ad; transform: scale(.99); }
.today-head, .tools-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.today-title { color: #27241f; font-size: 31rpx; font-weight: 740; }
.today-date { margin-top: 8rpx; color: #8d6c3e; font-size: 21rpx; }
.today-link { padding-top: 4rpx; color: #8a572f; font-size: 22rpx; font-weight: 650; }
.summary-loading { padding: 31rpx 0 18rpx; }
.skeleton { height: 22rpx; border-radius: 7rpx; background: rgba(141, 108, 62, .14); }
.skeleton-wide { width: 72%; }
.skeleton-short { width: 46%; margin-top: 18rpx; }
.summary-empty { padding: 34rpx 0 24rpx; }
.summary-empty-title { color: #4c4236; font-size: 27rpx; font-weight: 680; }
.summary-empty-copy { margin-top: 10rpx; color: #8e7d68; font-size: 22rpx; line-height: 1.6; }
.today-list { margin-top: 24rpx; }
.today-task { display: grid; grid-template-columns: 14rpx 78rpx minmax(0, 1fr) auto; align-items: center; gap: 12rpx; min-height: 62rpx; }
.today-task + .today-task { border-top: 1rpx solid rgba(109, 76, 35, .10); }
.task-state { width: 12rpx; height: 12rpx; border-radius: 4rpx; background: #9a6439; }
.today-task.is-done .task-state { background: #b9aa8e; }
.today-task.is-cancelled .task-state { background: #c9bfae; }
.task-time { color: #725434; font-size: 22rpx; font-weight: 650; }
.task-title { overflow: hidden; color: #3c352d; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.today-task.is-done .task-title, .today-task.is-cancelled .task-title { color: #9b8d7b; text-decoration: line-through; }
.task-status { color: #8d6c3e; font-size: 19rpx; }
.more-summary { padding-top: 18rpx; color: #8d6c3e; font-size: 21rpx; }
.today-stats { display: flex; gap: 24rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(109, 76, 35, .12); color: #765f43; font-size: 21rpx; }

.tools-section { margin-top: 38rpx; }
.tools-title { color: #27241f; font-size: 31rpx; font-weight: 740; }
.tools-note { padding-top: 5rpx; color: #9c958b; font-size: 21rpx; }
.tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-top: 22rpx; }
.mini-tool { min-height: 210rpx; padding: 24rpx; border-radius: 18rpx; background: #fffdfa; box-shadow: 0 10rpx 26rpx rgba(84, 65, 43, .055); transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.mini-tool:active { background: #fff8e8; transform: scale(.98); }
.tool-icon-wrap { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 14rpx; }
.tool-icon-wrap.honey { background: #fff0bd; }
.tool-icon-wrap.caramel { background: #f3dfcd; }
.tool-icon-wrap.cream { background: #f7eadc; }
.tool-icon-wrap.paper { background: #f5edda; }
.tool-icon { width: 54rpx; height: 54rpx; }
.mini-tool-title { margin-top: 22rpx; color: #2f2a24; font-size: 27rpx; font-weight: 700; line-height: 1.35; }
.mini-tool-copy { margin-top: 9rpx; color: #8a8278; font-size: 21rpx; line-height: 1.45; }
.home-footer { padding: 36rpx 0 6rpx; color: #aaa298; font-size: 20rpx; text-align: center; }

@media (prefers-reduced-motion: reduce) {
  .today-card, .mini-tool { transition-property: background-color; }
  .today-card:active, .mini-tool:active { transform: none; }
}
