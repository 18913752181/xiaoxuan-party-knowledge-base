.home-page { padding-top: 40rpx; padding-bottom: 160rpx; }
.brand-mark { display: inline-flex; align-items: center; padding: 10rpx 18rpx; border-radius: 999rpx; background: #fff0e4; color: #b96d39; font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }
.tool-card, .education-card { padding: 36rpx; }
.tool-card { background: linear-gradient(145deg, #fff9f1 0%, #fdf1e2 100%); }
.education-card { margin-top: 24rpx; background: linear-gradient(145deg, #fffdfa 0%, #fff4e9 100%); }
.card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.tool-icon { width: 104rpx; height: 104rpx; margin: -10rpx -8rpx 0 0; flex: none; }
.card-category { color: #b96d39; font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }
.tool-title { margin-top: 20rpx; color: #5b4030; font-size: 40rpx; font-weight: 700; letter-spacing: .5rpx; }
.tool-description { margin-top: 14rpx; color: #8b7566; font-size: 26rpx; line-height: 1.7; }
.capability-line { display: flex; gap: 0; margin-top: 22rpx; color: #aa8873; font-size: 22rpx; }
.capability-line text { display: flex; align-items: center; }
.capability-line text + text { margin-left: 16rpx; padding-left: 16rpx; border-left: 1rpx solid rgba(185,109,57,.22); }
.entry-button { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 94rpx; margin-top: 30rpx; padding: 0 28rpx; border: 0; border-radius: 999rpx; background: #a65a31; color: #fffaf5; box-shadow: 0 12rpx 26rpx rgba(166,90,49,.2); font-size: 28rpx; font-weight: 600; line-height: 94rpx; transition: transform 140ms cubic-bezier(.23,1,.32,1), background-color 140ms ease; }
.entry-button:active { background: #8f4826; transform: scale(.97); }
.arrow { font-size: 36rpx; font-weight: 400; }
.education-title { margin-top: 20rpx; color: #5b4030; font-size: 36rpx; font-weight: 700; }
.education-description { margin-top: 12rpx; color: #8b7566; font-size: 25rpx; line-height: 1.68; }
.home-footer { display: flex; justify-content: center; gap: 20rpx; padding: 34rpx 0 8rpx; color: #aaa098; font-size: 21rpx; }
.home-footer text + text { display: flex; align-items: center; }
.home-footer text + text::before { width: 5rpx; height: 5rpx; margin-right: 20rpx; border-radius: 50%; background: #d8c9be; content: ''; }
@media (prefers-reduced-motion: reduce) {
  .entry-button { transition-property: background-color; }
  .entry-button:active { transform: none; }
}
